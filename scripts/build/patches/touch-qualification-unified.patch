+ * failure while carrying out a legitimate request (in which case a
+ * permanent fallback has also been triggered - see the callers below). */
+static int ns2009_qual_set_mode(struct ns2009_data *data, enum ns2009_qual_mode requested)
+{
+	int error;
+
+	mutex_lock(&data->qual_lock);
+
+	if (data->qual_permanent_fallback) {
+		mutex_unlock(&data->qual_lock);
+		return requested == NS2009_QUAL_MODE_POLL_ONLY ? 0 : -EPERM;
+	}
+
+	/* Don't let userspace jump straight from poll-only to irq-assist -
+	 * irq-observe must be selected first, at least once, this boot. */
+	if (requested == NS2009_QUAL_MODE_IRQ_ASSIST && !data->qual_irq_observe_entered) {
+		mutex_unlock(&data->qual_lock);
+		return -EINVAL;
+	}
+
+	if (requested == data->qual_mode) {
+		mutex_unlock(&data->qual_lock);
+		return 0;
+	}
+
+	switch (requested) {
+	case NS2009_QUAL_MODE_POLL_ONLY:
+		if (data->qual_irq_requested && data->qual_irq_armed) {
+			disable_irq_nosync(data->qual_irq);
+			data->qual_irq_armed = false;
+		}
+		data->qual_active_poll = false;
+		data->qual_first_sample_pending = false;
+		input_set_poll_interval(data->input, POLL_INTERVAL);
+		break;
+
+	case NS2009_QUAL_MODE_IRQ_OBSERVE:
+		if (!data->qual_irq_requested) {
+			error = ns2009_qual_request_irq(data);
+			if (error) {
+				mutex_unlock(&data->qual_lock);
+				ns2009_qual_trigger_fallback(data, "irq_request_failed");
+				return -EIO;
+			}
+		} else if (!data->qual_irq_armed) {
+			enable_irq(data->qual_irq);
+			data->qual_irq_armed = true;
+		}
+		data->qual_irq_observe_entered = true;
+		data->qual_active_poll = false;
+		data->qual_first_sample_pending = false;
+		input_set_poll_interval(data->input, POLL_INTERVAL);
+		break;
+
+	case NS2009_QUAL_MODE_IRQ_ASSIST:
+		if (!data->qual_irq_requested) {
+			/* Defense in depth only - unreachable in practice,
+			 * since entry is gated on qual_irq_observe_entered
+			 * above, which is only ever set true after a
+			 * successful ns2009_qual_request_irq(). */
+			mutex_unlock(&data->qual_lock);
+			ns2009_qual_trigger_fallback(data, "irq_assist_without_irq");
+			return -EIO;
+		}
+		if (!data->qual_irq_armed) {
+			enable_irq(data->qual_irq);
+			data->qual_irq_armed = true;
+		}
+		data->qual_active_poll = false;
+		data->qual_first_sample_pending = false;
+		input_set_poll_interval(data->input, NS2009_QUAL_SAFETY_POLL_INTERVAL_MS);
+		break;
+	}
+
+	data->qual_prev_mode = data->qual_mode;
+	data->qual_mode = requested;
+	data->qual_mode_transition_count++;
+
+	mutex_unlock(&data->qual_lock);
+	return 0;
+}
+
+static int ns2009_qual_status_show(struct seq_file *s, void *unused)
+{
+	struct ns2009_data *data = s->private;
+
+	seq_printf(s, "mode: %s\n", ns2009_qual_mode_name(data->qual_mode));
+	seq_printf(s, "previous_mode: %s\n", ns2009_qual_mode_name(data->qual_prev_mode));
+	seq_printf(s, "mode_transition_count: %llu\n", data->qual_mode_transition_count);
+	seq_printf(s, "permanent_fallback: %d\n", data->qual_permanent_fallback);
+	seq_printf(s, "fallback_count: %llu\n", data->qual_fallback_count);
+	seq_printf(s, "fallback_reason: %s\n", data->qual_fallback_reason ?: "none");
+	seq_printf(s, "poll_count: %llu\n", data->qual_poll_count);
+	seq_printf(s, "touch_down_count: %llu\n", data->qual_touch_down_count);
+	seq_printf(s, "release_count: %llu\n", data->qual_release_count);
+	seq_printf(s, "irq: %d\n", data->qual_irq_requested ? data->qual_irq : -1);
+	seq_printf(s, "irq_trigger: 0x%x\n", data->qual_irq_trigger_type);
+	seq_printf(s, "irq_armed: %d\n", data->qual_irq_armed);
+	seq_printf(s, "irq_request_failure: %d\n", data->qual_irq_request_failure);
+	seq_printf(s, "irq_event_count: %llu\n", data->qual_irq_event_count);
+	seq_printf(s, "irq_events_while_idle: %llu\n", data->qual_irq_events_while_idle);
+	seq_printf(s, "irq_events_while_touched: %llu\n", data->qual_irq_events_while_touched);
+	seq_printf(s, "irq_min_interval_ms: %u\n",
+		   jiffies_to_msecs(data->qual_min_irq_interval_jiffies));
+	seq_printf(s, "irq_max_interval_ms: %u\n",
+		   jiffies_to_msecs(data->qual_max_irq_interval_jiffies));
+	/* Not cheaply measurable: the design mandates a NULL hard-IRQ
+	 * handler (see ns2009_qual_request_irq()), so there is no hard-IRQ
+	 * timestamp to diff against the threaded handler's own start time. */
+	seq_printf(s, "irq_to_worker_latency_ms: 0 (unmeasurable, NULL hard-IRQ handler by design)\n");
+	seq_printf(s, "touch_down_to_first_sample_latency_ms: %u\n",
+		   jiffies_to_msecs(data->qual_touch_down_to_first_sample_jiffies));
+	seq_printf(s, "active_poll_active: %d\n", data->qual_active_poll);
+	seq_printf(s, "active_poll_spell_count: %llu\n", data->qual_active_poll_spell_count);
+	seq_printf(s, "active_poll_total_duration_ms: %u\n",
+		   jiffies_to_msecs(data->qual_active_poll_total_jiffies));
+	seq_printf(s, "safety_poll_count: %llu\n", data->qual_safety_poll_count);
+	seq_printf(s, "missed_touch_count: %llu\n", data->qual_missed_touch_count);
+	seq_printf(s, "storm_window_count: %u\n", data->qual_storm_window_count);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ns2009_qual_status);
+
+/* Zeroes cumulative counters only - deliberately leaves the current mode,
+ * permanent-fallback state/reason, and any live transition-tracking fields
+ * (qual_last_transition_was_down, qual_active_poll, qual_irq_observe_entered,
+ * qual_irq_requested/armed) untouched, same non-fabrication rationale as
+ * TOUCH-D0-DIAG's own reset: resetting those could otherwise fabricate a
+ * false transition/duration measurement, or silently hide that a fallback
+ * already happened. */
+static ssize_t ns2009_qual_reset_write(struct file *file, const char __user *ubuf,
+					size_t count, loff_t *ppos)
+{
+	struct ns2009_data *data = file->private_data;
+
+	mutex_lock(&data->qual_lock);
+
+	data->qual_mode_transition_count = 0;
+	data->qual_poll_count = 0;
+	data->qual_touch_down_count = 0;
+	data->qual_release_count = 0;
+	data->qual_irq_event_count = 0;
+	data->qual_irq_events_while_idle = 0;
+	data->qual_irq_events_while_touched = 0;
+	data->qual_min_irq_interval_jiffies = 0;
+	data->qual_max_irq_interval_jiffies = 0;
+	data->qual_touch_down_to_first_sample_jiffies = 0;
+	data->qual_active_poll_spell_count = 0;
+	data->qual_active_poll_total_jiffies = 0;
+	data->qual_safety_poll_count = 0;
+	data->qual_missed_touch_count = 0;
+	data->qual_storm_window_count = 0;
+
+	mutex_unlock(&data->qual_lock);
+
+	return count;
+}
+
+static const struct file_operations ns2009_qual_reset_fops = {
+	.open = simple_open,
+	.write = ns2009_qual_reset_write,
+	.llseek = no_llseek,
+};
+
+/* mode: write one of "poll-only" / "irq-observe" / "irq-assist" (no
+ * trailing-whitespace sensitivity - stripped via strim()). Anything else is
+ * rejected with -EINVAL, never silently ignored. */
+static ssize_t ns2009_qual_mode_write(struct file *file, const char __user *ubuf,
+				       size_t count, loff_t *ppos)
+{
+	struct ns2009_data *data = file->private_data;
+	char buf[16];
+	size_t len = min(count, sizeof(buf) - 1);
+	enum ns2009_qual_mode requested;
+	int error;
+
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+	strim(buf);
+
+	if (!strcmp(buf, "poll-only"))
+		requested = NS2009_QUAL_MODE_POLL_ONLY;
+	else if (!strcmp(buf, "irq-observe"))
+		requested = NS2009_QUAL_MODE_IRQ_OBSERVE;
+	else if (!strcmp(buf, "irq-assist"))
+		requested = NS2009_QUAL_MODE_IRQ_ASSIST;
+	else
+		return -EINVAL;
+
+	error = ns2009_qual_set_mode(data, requested);
+	if (error)
+		return error;
+
+	return count;
+}
+
+static ssize_t ns2009_qual_mode_read(struct file *file, char __user *ubuf,
+				      size_t count, loff_t *ppos)
+{
+	struct ns2009_data *data = file->private_data;
+	char buf[16];
+	int len;
+
+	len = scnprintf(buf, sizeof(buf), "%s\n", ns2009_qual_mode_name(data->qual_mode));
+	return simple_read_from_buffer(ubuf, count, ppos, buf, len);
+}
+
+static const struct file_operations ns2009_qual_mode_fops = {
+	.open = simple_open,
+	.read = ns2009_qual_mode_read,
+	.write = ns2009_qual_mode_write,
+	.llseek = default_llseek,
+};
+
+static void ns2009_qual_setup(struct ns2009_data *data)
+{
+	mutex_init(&data->qual_lock);
+	data->qual_mode = NS2009_QUAL_MODE_POLL_ONLY;
+	data->qual_prev_mode = NS2009_QUAL_MODE_POLL_ONLY;
+	data->qual_fallback_reason = "none";
+	data->qual_storm_window_start = jiffies;
+
+	data->qual_debugfs_dir = debugfs_create_dir("ns2009_qualification", NULL);
+	if (IS_ERR_OR_NULL(data->qual_debugfs_dir)) {
+		data->qual_debugfs_dir = NULL;
+		return;
+	}
+	debugfs_create_file("status", 0444, data->qual_debugfs_dir, data,
+			     &ns2009_qual_status_fops);
+	debugfs_create_file("mode", 0644, data->qual_debugfs_dir, data,
+			     &ns2009_qual_mode_fops);
+	debugfs_create_file("reset_counters", 0200, data->qual_debugfs_dir, data,
+			     &ns2009_qual_reset_fops);
+}
