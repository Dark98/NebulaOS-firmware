#!/bin/sh
#
# CYW43430 Wi-Fi firmware engineering-test failsafe (2026-08-08). Wi-Fi is
# both the variable under test (7.45.98.125 vs the 7.46.58.13 control) and
# the only remote access path to this device - a firmware/CLM regression
# that breaks association would otherwise strand the device on a slot with
# no way to reach it except physically. This script closes that gap for
# the WIFI-FW-125 engineering build specifically.
#
# NO-OP ON EVERY NORMAL/CANONICAL BUILD: only scripts/build/wifi-firmware-
# 125-variant.sh's own `apply` step drops the sentinel file this script
# checks for below. A normal ./build.sh never creates that sentinel, so
# this script does nothing at all (single stat, then exit) on every real
# baseline build - confirmed by construction, not just by intent.
#
# Extends the EXISTING OTA/confirm-good mechanism (S00revert-safety writes
# "ota:kernel" - stock - unconditionally on every boot start; S99confirm-
# good only flips it forward to "ota:kernel2" once Moonraker confirms
# Klipper ready) rather than creating a second, independent boot-selection
# system: this script runs immediately BEFORE S99confirm-good (S98 < S99)
# and, on a Wi-Fi health failure, writes the marker back to stock and
# reboots immediately - S99confirm-good then never runs at all this boot
# (a `reboot` here ends the whole init sequence), so there is no scenario
# where both scripts race to decide the marker's final state. On success
# this script is a pure no-op past its own health check: S99confirm-good
# runs completely unmodified right after it, exactly as it does on every
# non-Wi-Fi-test build.
#
# Deliberately entirely local: never depends on SSH, Moonraker, or the
# Wi-Fi connection it is itself evaluating being the verification channel
# (that would be circular). Every check below reads local kernel/network
# state directly (/sys/class/net, `ip`, a direct ping to the DHCP-learned
# default gateway's own IP - never a hostname, so no DNS dependency
# either).
#
# Single trigger, no reboot loop: a revert-to-stock reboot lands on the
# real stock slot, which does not run any of this NebulaOS init sequence
# at all - there is nothing on stock that could re-arm or re-trigger this
# script. The only way this build boots again is a deliberate, separate
# marker flip (by a human or a later test run), each one a fresh,
# independent health evaluation - never an automatic loop.
#
# Overridable for tests/wifi-125-failsafe-tests.sh (same fixture-path
# convention as scripts/flash-spare-slot.sh's DEV_PREFIX) - real boot
# never sets these, so ":=" always resolves to the real paths/device.
SENTINEL="${SENTINEL:-/etc/nebulaos-wifi-125-test-marker}"
MARKER_DEV="${MARKER_DEV:-/dev/mmcblk0p1}"
IFACE="${IFACE:-wlan0}"
SYSNET="${SYSNET:-/sys/class/net}"
TIMEOUT="${WIFI_125_FAILSAFE_TIMEOUT:-120}"
INTERVAL="${WIFI_125_FAILSAFE_INTERVAL:-2}"
# Diagnostic log on the SHARED, persistent /usr/data partition (mounted
# identically regardless of which slot is active - FIRMWARE.md's own
# mmcblk0p10 description) rather than anywhere under the rootfs itself:
# dmesg/journal is wiped on every reboot, and a revert-to-stock reboot is
# exactly this script's own failure path, so a plain rootfs-local log
# would be destroyed at the exact moment it becomes most useful. Written
# from custom, still readable from stock afterward - a real, found-live
# gap (2026-08-09): the first WIFI-FW-125 boot's actual brcmfmac/
# wpa_supplicant failure detail was unrecoverable once the device
# reverted, since nothing had captured it anywhere persistent.
LOGFILE="${LOGFILE:-/usr/data/wifi-125-test-diagnostics.log}"

log() {
	echo "S98nebulaos-wifi-125-failsafe: $1"
}

capture_diagnostics() {
	label="$1"
	{
		echo "=== S98nebulaos-wifi-125-failsafe diagnostics: $label ($(date -u +%Y-%m-%dT%H:%M:%SZ), uptime $(cut -d' ' -f1 /proc/uptime 2>/dev/null)s) ==="
		echo "--- wifi_healthy() sub-checks ---"
		echo "iface present: $([ -d "$SYSNET/$IFACE" ] && echo yes || echo no)"
		echo "carrier: $(cat "$SYSNET/$IFACE/carrier" 2>/dev/null || echo 'n/a')"
		echo "operstate: $(cat "$SYSNET/$IFACE/operstate" 2>/dev/null || echo 'n/a')"
		echo "--- ip addr show $IFACE ---"
		ip addr show "$IFACE" 2>&1
		echo "--- ip route show default dev $IFACE ---"
		ip route show default dev "$IFACE" 2>&1
		echo "--- wpa_cli status (if reachable) ---"
		wpa_cli -i "$IFACE" status 2>&1
		echo "--- dmesg: brcmfmac/CFG80211/wl0/firmware/clm lines ---"
		dmesg 2>/dev/null | grep -aiE "brcmfmac|brcmutil|cfg80211|wl0|firmware|clm|nvram|sdio"
		echo "=== end $label ==="
		echo
	} >> "$LOGFILE" 2>&1
}

wifi_healthy() {
	# 1. brcmfmac actually initialized this interface at all.
	[ -d "$SYSNET/$IFACE" ] || return 1

	# 2. Link-layer association (carrier up = associated to an AP at the
	# driver level, independent of IP - this is what "wlan association
	# successful" means here, checked the same way `ip link` itself
	# derives UP/LOWER_UP).
	[ "$(cat "$SYSNET/$IFACE/carrier" 2>/dev/null)" = "1" ] || return 1

	# 3. IP address acquired via DHCP.
	ip -4 addr show "$IFACE" 2>/dev/null | grep -q "inet " || return 1

	# 4. Usable connectivity: ping the DHCP-learned default gateway's own
	# IP address directly - never a hostname (no DNS dependency) and
	# never anything off-link (no dependency on the wider internet being
	# reachable, only on THIS Wi-Fi hop actually working).
	gateway=$(ip -4 route show default dev "$IFACE" 2>/dev/null | sed -n 's/^default via \([0-9.]*\).*/\1/p' | head -1)
	[ -n "$gateway" ] || return 1
	ping -c 1 -W 2 "$gateway" >/dev/null 2>&1 || return 1

	return 0
}

fail_to_stock() {
	log "Wi-Fi health check FAILED after ${TIMEOUT}s (fw=$1) - reverting to stock"
	# Same byte format as /etc/ota_marker.sh (shared with S00revert-safety/
	# S99confirm-good) - written directly here rather than sourcing that
	# file, since this script must keep working even if some future,
	# unrelated change to that shared file ever broke it (this is a
	# safety-critical path with its own, deliberately minimal dependency
	# surface).
	printf 'ota:kernel\n\n' > "$MARKER_DEV"
	dd if=/dev/zero of="$MARKER_DEV" bs=1 seek=13 count=499 2>/dev/null
	readback=$(head -c 11 "$MARKER_DEV" 2>/dev/null)
	if [ "$readback" != "ota:kernel" ]; then
		log "FATAL: marker readback '$readback' does not match 'ota:kernel' after write - refusing to reboot blind, stopping here"
		echo "SAFE_FOR_MANUAL_REBOOT_TO_STOCK=YES" 1>&2
		return 1
	fi
	log "marker verified as ota:kernel - syncing and rebooting to stock now"
	sync
	if [ -z "${S98NEBULAOS_WIFI_125_FAILSAFE_NO_AUTORUN:-}" ]; then
		reboot
	fi
	# If `reboot` itself is ever unavailable/denied in some environment,
	# fall through to the same safe-stop contract rather than looping.
	echo "SAFE_FOR_MANUAL_REBOOT_TO_STOCK=YES" 1>&2
	return 1
}

start() {
	[ -f "$SENTINEL" ] || { log "no engineering-test sentinel ($SENTINEL) - not a WIFI-FW-125 build, nothing to do"; return 0; }

	log "engineering-test sentinel present - Wi-Fi health gate armed (timeout ${TIMEOUT}s), diagnostics -> $LOGFILE"
	capture_diagnostics "start (t=0s)"

	elapsed=0
	last_captured=0
	while [ "$elapsed" -lt "$TIMEOUT" ]; do
		if wifi_healthy; then
			fw=$(dmesg 2>/dev/null | sed -n 's/.*Firmware: \(.*\)/\1/p' | tail -1)
			log "Wi-Fi healthy (fw: ${fw:-unknown}) after ${elapsed}s - cancelling failsafe, continuing normally"
			capture_diagnostics "success (t=${elapsed}s)"
			return 0
		fi
		elapsed=$((elapsed + INTERVAL))
		# Periodic progress snapshot (every ~20s) rather than every
		# INTERVAL - dmesg is cumulative for the whole boot already, so a
		# tight per-iteration capture would just be redundant noise, not
		# more information.
		if [ "$((elapsed - last_captured))" -ge 20 ]; then
			capture_diagnostics "still unhealthy (t=${elapsed}s)"
			last_captured="$elapsed"
		fi
		sleep "$INTERVAL"
	done

	capture_diagnostics "timeout reached (t=${elapsed}s) - about to revert"
	fail_to_stock "$(dmesg 2>/dev/null | sed -n 's/.*Firmware: \(.*\)/\1/p' | tail -1)"
}

# S98NEBULAOS_WIFI_125_FAILSAFE_NO_AUTORUN=1 lets tests/wifi-125-failsafe-
# tests.sh source this script (same convention as every other NebulaOS
# init script in this repo) to call wifi_healthy()/fail_to_stock()/start()
# directly against fixture paths, without also running the real dispatch
# below or ever calling a real `reboot`.
if [ -z "${S98NEBULAOS_WIFI_125_FAILSAFE_NO_AUTORUN:-}" ]; then
	case "$1" in
		start)
			start
			;;
		*)
			;;
	esac
	exit 0
fi
