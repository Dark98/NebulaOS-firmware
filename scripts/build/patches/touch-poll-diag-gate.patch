diff --git a/kernel/kernel-6.6/drivers/input/touchscreen/Kconfig b/kernel/kernel-6.6/drivers/input/touchscreen/Kconfig
index d6a9b95cb..6ba1c9779 100644
--- a/kernel/kernel-6.6/drivers/input/touchscreen/Kconfig
+++ b/kernel/kernel-6.6/drivers/input/touchscreen/Kconfig
@@ -1155,6 +1155,27 @@ config TOUCHSCREEN_NS2009
 	  To compile this driver as a module, choose M here: the
 	  module will be called ns2009.
 
+config TOUCHSCREEN_NS2009_POLL_DIAG
+	bool "add read-only pendown-gpios poll diagnostics (TOUCH-D0-DIAG)"
+	depends on TOUCHSCREEN_NS2009
+	default n
+	help
+	  TOUCH-D0-DIAG (display/touch investigation mission follow-on,
+	  2026-08-01+): characterizes the existing pendown-gpios polling
+	  path with zero behavior change - pure read-only observability
+	  layered on top of it. Does not alter the poll interval,
+	  coordinate reads, calibration, filtering, or input event
+	  reporting in any way.
+
+	  Adds in-memory-only diagnostic counters (exposed via debugfs, one
+	  reset file, never logged per-poll to the kernel log): raw pendown
+	  GPIO level, an inferred idle level, last touch-down/release
+	  transition timestamps, current/min/max contact duration, poll
+	  count, touch-down/release counts, an unexpected-transition sanity
+	  counter, and a bounce counter.
+
+	  Disabled by default. If unsure, say N.
+
