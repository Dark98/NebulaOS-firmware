 	ret = ns2009_ts_report(data);
 	if (ret)
 		dev_err(&input_dev->dev, "Poll touch data failed: %d\n", ret);
@@ -191,6 +327,85 @@ static int ns2009_ts_request_polled_input_dev(struct ns2009_data *data)
 	return 0;
 }
 
+#ifdef CONFIG_TOUCHSCREEN_NS2009_POLL_DIAG
+static int ns2009_diag_status_show(struct seq_file *s, void *unused)
+{
+	struct ns2009_data *data = s->private;
+	unsigned long contact_duration_ms = 0;
+	int idle_level = -1;
+
+	if (data->pen_down)
+		contact_duration_ms = jiffies_to_msecs(jiffies - data->diag_last_down_jiffies);
+
+	if (data->diag_raw_high_count || data->diag_raw_low_count)
+		idle_level = data->diag_raw_high_count >= data->diag_raw_low_count ? 1 : 0;
+
+	seq_printf(s, "poll_count: %llu\n", data->diag_poll_count);
+	seq_printf(s, "raw_level: %d\n", data->diag_raw_level);
+	seq_printf(s, "idle_level_inferred: %d\n", idle_level);
+	seq_printf(s, "last_down_jiffies: %lu\n", data->diag_last_down_jiffies);
+	seq_printf(s, "last_up_jiffies: %lu\n", data->diag_last_up_jiffies);
+	seq_printf(s, "contact_duration_ms: %lu\n", contact_duration_ms);
+	seq_printf(s, "touch_down_count: %llu\n", data->diag_touch_down_count);
+	seq_printf(s, "release_count: %llu\n", data->diag_release_count);
+	seq_printf(s, "unexpected_transition_count: %llu\n",
+		   data->diag_unexpected_transition_count);
+	seq_printf(s, "bounce_count: %llu\n", data->diag_bounce_count);
+	seq_printf(s, "min_contact_duration_ms: %lu\n",
+		   data->diag_min_contact_duration_ms == NS2009_DIAG_DURATION_UNSET ?
+		   0 : data->diag_min_contact_duration_ms);
+	seq_printf(s, "max_contact_duration_ms: %lu\n", data->diag_max_contact_duration_ms);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ns2009_diag_status);
+
+/* Zeroes every counter/min-max field, but deliberately leaves live
+ * transition-tracking state (diag_raw_level, diag_last_transition_was_down,
+ * diag_last_down_jiffies/diag_last_up_jiffies) untouched - resetting those
+ * could otherwise fabricate a false transition/duration measurement on the
+ * very next poll. Only ever runs when explicitly written to - never on any
+ * timer or automatic condition. */
+static ssize_t ns2009_diag_reset_write(struct file *file, const char __user *ubuf,
+					size_t count, loff_t *ppos)
+{
+	struct ns2009_data *data = file->private_data;
+
+	data->diag_poll_count = 0;
+	data->diag_touch_down_count = 0;
+	data->diag_release_count = 0;
+	data->diag_unexpected_transition_count = 0;
+	data->diag_bounce_count = 0;
+	data->diag_raw_high_count = 0;
+	data->diag_raw_low_count = 0;
+	data->diag_min_contact_duration_ms = NS2009_DIAG_DURATION_UNSET;
+	data->diag_max_contact_duration_ms = 0;
+
+	return count;
+}
+
+static const struct file_operations ns2009_diag_reset_fops = {
+	.open = simple_open,
+	.write = ns2009_diag_reset_write,
+	.llseek = no_llseek,
+};
+
+static void ns2009_diag_setup(struct ns2009_data *data)
+{
+	data->diag_min_contact_duration_ms = NS2009_DIAG_DURATION_UNSET;
+	data->diag_raw_level = -1;
+
+	data->diag_debugfs_dir = debugfs_create_dir(NS2009_TS_NAME "_poll_diag", NULL);
+	if (IS_ERR_OR_NULL(data->diag_debugfs_dir)) {
+		data->diag_debugfs_dir = NULL;
+		return;
+	}
+	debugfs_create_file("status", 0444, data->diag_debugfs_dir, data,
+			     &ns2009_diag_status_fops);
+	debugfs_create_file("reset", 0200, data->diag_debugfs_dir, data,
+			     &ns2009_diag_reset_fops);
+}
+#endif
+
 static int ns2009_ts_probe(struct i2c_client *client)
 {
 	struct ns2009_data *data;
@@ -227,6 +442,12 @@ static int ns2009_ts_probe(struct i2c_client *client)
 	if (error)
 		return error;
 
+#ifdef CONFIG_TOUCHSCREEN_NS2009_POLL_DIAG
+	/* Always after the poller is already up and working - purely
+	 * observational, never a condition for probe() succeeding. */
+	ns2009_diag_setup(data);
+#endif
+
 	return 0;
 };
 
