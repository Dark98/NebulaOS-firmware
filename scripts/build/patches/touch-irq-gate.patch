# *** DEPRECATED (2026-08-01+) *** - superseded by
# scripts/build/patches/touch-qualification-unified.patch
# (CONFIG_TOUCHSCREEN_NS2009_QUALIFICATION), applied only via
# scripts/build/touch-qualification-variant.sh from now on. This patch's
# both-edges IRQ-assisted trigger placeholder is now known-outdated (see
# docs/NEBULAOS_TOUCH_IRQ_TRIGGER_FINDINGS.md: GPIO79 is
# IDLE_HIGH_ACTIVE_LOW, touch-down is a FALLING edge) and its real
# successor is the unified driver's runtime "irq-assist" mode, which uses
# a falling-edge trigger and reuses the existing poll/report path instead
# of calling it directly from IRQ context. Kept only for project-history/
# test reference (e.g. as a citation for the storm-protection pattern) -
# do not apply this patch directly, and never compose it with
# touch-qualification-unified.patch, touch-poll-diag-gate.patch, or
# touch-irq-diag-gate.patch (all four touch the identical two files;
# composing any of them silently discards whichever was applied first -
# see scripts/build/touch-qualification-variant.sh's header for the full
# incident history this retires).
diff --git a/kernel/kernel-6.6/drivers/input/touchscreen/Kconfig b/kernel/kernel-6.6/drivers/input/touchscreen/Kconfig
index d6a9b95cb..1290da8fb 100644
--- a/kernel/kernel-6.6/drivers/input/touchscreen/Kconfig
+++ b/kernel/kernel-6.6/drivers/input/touchscreen/Kconfig
@@ -1155,6 +1155,24 @@ config TOUCHSCREEN_NS2009
 	  To compile this driver as a module, choose M here: the
 	  module will be called ns2009.
 
+config TOUCHSCREEN_NS2009_PENDOWN_IRQ
+	bool "request an interrupt on pendown-gpios as a latency accelerant"
+	depends on TOUCHSCREEN_NS2009
+	default n
+	help
+	  TOUCH-I1 prototype (display/touch investigation mission,
+	  2026-08-01): additionally requests a both-edges threaded IRQ on
+	  the optional pendown-gpios pin, purely to trigger an immediate
+	  touch report sooner than the next scheduled 30ms poll tick would.
+	  The existing, unchanged poll remains active unconditionally - this
+	  option can only improve latency, never replace or weaken the
+	  existing polling fallback. Includes storm protection (falls back
+	  to poll-only, permanently, if the pin toggles abnormally often).
+
+	  Disabled by default - never enable for a production build until
+	  live hardware testing confirms the real GPIO79 trigger behavior.
+	  If unsure, say N.
+
 config TOUCHSCREEN_TSC2007
 	tristate "TSC2007 based touchscreens"
 	depends on I2C
diff --git a/kernel/kernel-6.6/drivers/input/touchscreen/ns2009.c b/kernel/kernel-6.6/drivers/input/touchscreen/ns2009.c
index 99a2a7ee1..46f418862 100644
--- a/kernel/kernel-6.6/drivers/input/touchscreen/ns2009.c
+++ b/kernel/kernel-6.6/drivers/input/touchscreen/ns2009.c
@@ -23,10 +23,43 @@
 #include <linux/input/touchscreen.h>
 #include <linux/i2c.h>
 #include <linux/gpio/consumer.h>
+#include <linux/interrupt.h>
+#include <linux/jiffies.h>
+#include <linux/debugfs.h>
+#include <linux/atomic.h>
 
 /* polling interval in ms */
 #define POLL_INTERVAL	30
 
+#ifdef CONFIG_TOUCHSCREEN_NS2009_PENDOWN_IRQ
+/* TOUCH-I1 prototype (display/touch investigation mission, 2026-08-01):
+ * an OPTIONAL, purely-additive latency accelerant layered on top of the
+ * existing, unchanged, always-on 30ms poll above - it is never a
+ * replacement for it. The exact edge/level semantics of pendown-gpios were
+ * never established from source/disassembly alone (this driver's own
+ * history already warns against guessing GPIO polarity), so this
+ * deliberately requests BOTH edges: any transition on the pin, in either
+ * direction, just triggers an immediate out-of-band call to the same
+ * ns2009_ts_report() the ordinary poll already calls - the actual
+ * down/up state still comes from a fresh gpiod_get_value_cansleep() read
+ * inside that function, never from which edge fired. This sidesteps the
+ * active-high/low and edge-direction unknown entirely: getting the
+ * polarity "wrong" only costs one extra harmless report call, it can
+ * never cause a wrong touch state to be reported.
+ *
+ * If the IRQ can't be requested (gpiod_to_irq() fails, or the platform's
+ * pinctrl/gpiolib doesn't support an interrupt on this pin), or if it
+ * fires abnormally often (electrical noise/bounce), this driver silently
+ * falls back to relying on the unchanged poll alone for the rest of the
+ * device's lifetime - input availability never depends on this path
+ * succeeding. Disabled at compile time by default
+ * (CONFIG_TOUCHSCREEN_NS2009_PENDOWN_IRQ=n) - never enable for a
+ * production build until live hardware testing confirms the real GPIO79
+ * trigger behavior (see docs/NEBULAOS_DISPLAY_LIVE_QUALIFICATION_PLAN.md). */
+#define NS2009_IRQ_STORM_WINDOW_MS	1000
+#define NS2009_IRQ_STORM_THRESHOLD	50
+#endif
+
 /* this driver uses 12-bit readout */
 #define MAX_12BIT	0xfff
 
@@ -62,6 +95,19 @@ struct ns2009_data {
 	 * generic upstream Z1-threshold-only behavior unchanged for any other
 	 * board using this driver. */
 	struct gpio_desc		*pendown_gpio;
+
+#ifdef CONFIG_TOUCHSCREEN_NS2009_PENDOWN_IRQ
+	/* TOUCH-I1 prototype: purely additive to the fields above, never
+	 * replacing them - see the CONFIG_TOUCHSCREEN_NS2009_PENDOWN_IRQ
+	 * block comment near POLL_INTERVAL for the full design rationale. */
+	int				pendown_irq;
+	bool				irq_active;
+	unsigned long			irq_storm_window_start;
+	unsigned int			irq_storm_window_count;
+	atomic_t			irq_count;
+	atomic_t			irq_storm_triggered;
+	struct dentry			*debugfs_dir;
+#endif
 };
 
 static int ns2009_ts_read_data(struct ns2009_data *data, u8 cmd, u16 *val)
@@ -147,6 +193,54 @@ static void ns2009_ts_poll(struct input_dev *input_dev)
 		dev_err(&input_dev->dev, "Poll touch data failed: %d\n", ret);
 }
 
+#ifdef CONFIG_TOUCHSCREEN_NS2009_PENDOWN_IRQ
+/* TOUCH-I1 prototype: threaded IRQ handler (process context, not hard-IRQ -
+ * requested with a NULL hard-IRQ handler below, so this is the only handler
+ * that ever runs). Safe to call ns2009_ts_report() directly here - it does
+ * I2C transfers, which sleep, which is exactly why this is a threaded
+ * handler and not run from hard-IRQ context. This does nothing that the
+ * existing 30ms poll wouldn't eventually also do on its own - it only makes
+ * that same report happen sooner after a real GPIO transition. */
+static irqreturn_t ns2009_pendown_irq_thread(int irq, void *dev_id)
+{
+	struct ns2009_data *data = dev_id;
+	unsigned long now = jiffies;
+	int ret;
+
+	atomic_inc(&data->irq_count);
+
+	/* Storm protection: if too many edges land inside one rolling
+	 * window, this is electrical noise/bounce, not real touch activity -
+	 * disable the IRQ permanently for this device instance and rely on
+	 * the unchanged poll alone from then on. This is a one-way trip by
+	 * design (simple and safe) - a genuinely noisy line should not keep
+	 * re-arming and re-storming every window. */
+	if (time_before(now, data->irq_storm_window_start +
+			msecs_to_jiffies(NS2009_IRQ_STORM_WINDOW_MS))) {
+		data->irq_storm_window_count++;
+		if (data->irq_storm_window_count > NS2009_IRQ_STORM_THRESHOLD) {
+			data->irq_active = false;
+			atomic_inc(&data->irq_storm_triggered);
+			disable_irq_nosync(irq);
+			dev_warn(&data->client->dev,
+				 "pendown IRQ storm detected (>%d edges in %dms) - "
+				 "disabling IRQ permanently, falling back to poll-only\n",
+				 NS2009_IRQ_STORM_THRESHOLD, NS2009_IRQ_STORM_WINDOW_MS);
+			return IRQ_HANDLED;
+		}
+	} else {
+		data->irq_storm_window_start = now;
+		data->irq_storm_window_count = 1;
+	}
+
+	ret = ns2009_ts_report(data);
+	if (ret)
+		dev_err(&data->client->dev, "IRQ-triggered touch report failed: %d\n", ret);
+
+	return IRQ_HANDLED;
+}
+#endif
+
 static void ns2009_ts_config_input_dev(struct ns2009_data *data)
 {
 	struct input_dev *input = data->input;
@@ -191,6 +285,65 @@ static int ns2009_ts_request_polled_input_dev(struct ns2009_data *data)
 	return 0;
 }
 
+#ifdef CONFIG_TOUCHSCREEN_NS2009_PENDOWN_IRQ
+/* TOUCH-I1 prototype: best-effort only. Any failure here is logged and
+ * left non-fatal - probe() must succeed and the device must remain fully
+ * functional via the unchanged poll alone regardless of what happens in
+ * this function. Requests BOTH edges (see the block comment near
+ * POLL_INTERVAL for why) with a NULL hard-IRQ handler and IRQF_ONESHOT, so
+ * ns2009_pendown_irq_thread() runs entirely in a sleepable kernel thread,
+ * never in hard-IRQ context. */
+static void ns2009_setup_pendown_irq(struct ns2009_data *data)
+{
+	struct device *dev = &data->client->dev;
+	int irq;
+	int error;
+
+	if (!data->pendown_gpio) {
+		/* No pendown-gpios property at all (a board using the
+		 * original Z1-threshold fallback) - nothing to request an
+		 * IRQ on. Not an error. */
+		return;
+	}
+
+	irq = gpiod_to_irq(data->pendown_gpio);
+	if (irq < 0) {
+		dev_info(dev,
+			 "pendown GPIO does not support interrupts (%d) - "
+			 "continuing with poll-only, as before\n", irq);
+		return;
+	}
+
+	data->pendown_irq = irq;
+	data->irq_storm_window_start = jiffies;
+	data->irq_storm_window_count = 0;
+	atomic_set(&data->irq_count, 0);
+	atomic_set(&data->irq_storm_triggered, 0);
+
+	error = devm_request_threaded_irq(dev, irq, NULL,
+					   ns2009_pendown_irq_thread,
+					   IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING | IRQF_ONESHOT,
+					   "ns2009-pendown", data);
+	if (error) {
+		dev_info(dev,
+			 "could not request pendown IRQ %d (%d) - "
+			 "continuing with poll-only, as before\n", irq, error);
+		return;
+	}
+
+	data->irq_active = true;
+	dev_info(dev, "pendown IRQ %d active (poll remains active as fallback)\n", irq);
+
+	data->debugfs_dir = debugfs_create_dir(NS2009_TS_NAME, NULL);
+	if (!IS_ERR_OR_NULL(data->debugfs_dir)) {
+		debugfs_create_atomic_t("irq_count", 0444, data->debugfs_dir, &data->irq_count);
+		debugfs_create_atomic_t("irq_storm_triggered", 0444, data->debugfs_dir,
+					 &data->irq_storm_triggered);
+		debugfs_create_bool("irq_active", 0444, data->debugfs_dir, &data->irq_active);
+	}
+}
+#endif
+
 static int ns2009_ts_probe(struct i2c_client *client)
 {
 	struct ns2009_data *data;
@@ -227,6 +380,13 @@ static int ns2009_ts_probe(struct i2c_client *client)
 	if (error)
 		return error;
 
+#ifdef CONFIG_TOUCHSCREEN_NS2009_PENDOWN_IRQ
+	/* Best-effort, always after the poller is already up and working -
+	 * see ns2009_setup_pendown_irq()'s own comment for why this never
+	 * fails probe(). */
+	ns2009_setup_pendown_irq(data);
+#endif
+
 	return 0;
 };
 
