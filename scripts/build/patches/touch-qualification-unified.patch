+#ifdef CONFIG_TOUCHSCREEN_NS2009_QUALIFICATION
+/* Best-effort only, same non-fatal contract as the now-superseded
+ * TOUCH-I0-DIAG/TOUCH-I1 IRQ setup functions: any failure here is recorded
+ * and left non-fatal to the caller's own request (which itself never fails
+ * probe() - this is only ever invoked lazily, on the first transition into
+ * irq-observe, long after probe() has already succeeded). */
+static int ns2009_qual_request_irq(struct ns2009_data *data)
+{
+	struct device *dev = &data->client->dev;
+	int irq;
+	int error;
+
+	if (!data->pendown_gpio) {
+		/* No pendown-gpios property at all - nothing to request an
+		 * IRQ on. */
+		data->qual_irq_request_failure = -ENODEV;
+		return -ENODEV;
+	}
+
+	irq = gpiod_to_irq(data->pendown_gpio);
+	if (irq < 0) {
+		dev_info(dev,
+			 "qualification: pendown GPIO does not support interrupts (%d)\n",
+			 irq);
+		data->qual_irq_request_failure = irq;
+		return irq;
+	}
+
+	data->qual_irq = irq;
+	/* FALLING edge only - PROVEN_FROM_LIVE_TEST GPIO79 is
+	 * IDLE_HIGH_ACTIVE_LOW (see
+	 * docs/NEBULAOS_TOUCH_IRQ_TRIGGER_FINDINGS.md) - never both edges. */
+	data->qual_irq_trigger_type = IRQF_TRIGGER_FALLING;
+	data->qual_storm_window_start = jiffies;
+	data->qual_storm_window_count = 0;
+
+	error = devm_request_threaded_irq(dev, irq, NULL, ns2009_qual_irq_thread,
+					   data->qual_irq_trigger_type | IRQF_ONESHOT,
+					   "ns2009-qualification", data);
+	if (error) {
+		dev_info(dev, "qualification: could not request IRQ %d (%d)\n",
+			 irq, error);
+		data->qual_irq_request_failure = error;
+		return error;
+	}
+
+	data->qual_irq_requested = true;
+	data->qual_irq_armed = true;
+	dev_info(dev, "qualification: IRQ %d active for irq-observe\n", irq);
+	return 0;
+}
