#!/bin/sh
#
# Ephemeral, tmpfs-backed writable storage for this test image
# (FIRMWARE.md sec 24). Real gap found while checking whether GuppyScreen's
# WiFi panel could actually work here: this build has no writable overlay at
# all when booted from rootfs.squashfs - CONFIG_OVERLAY_FS isn't even built
# into the kernel, and nothing mounts a persistent writable layer anywhere.
# Without this, /opt/printer_data and /usr/data would be fully read-only
# (part of the squashfs), meaning printer.cfg edits, WiFi static-ip state,
# logs, and gcode uploads would all fail outright.
#
# Deliberately NOT using /dev/mmcblk0p9 (rootfs_data) or p10 (userdata) for
# this - both are confirmed live-mounted and actively used by the
# *currently-running stock OS* (shared across both A/B slots, not
# duplicated), so writing to either from this untested custom image risks
# corrupting the stock environment's own state. tmpfs is the safe choice for
# a first boot/peripheral smoke test: zero risk to any real partition, at
# the cost of nothing here surviving a reboot - acceptable and deliberate
# for what this test is trying to validate. A real, persistent, properly
# isolated storage scheme (a dedicated partition, or a clearly-separated
# subdirectory of p10) is real follow-up work, not done here.
#
# Runs after S00revert-safety (marker already flipped back to stock) but
# before anything that needs to read/write these paths - webcam/klipper/
# moonraker/guppyscreen (S50+) all come later.

seed_tmpfs() {
	dir="$1"
	snapshot="/tmp/.seed-snapshot-$$"
	mkdir -p "$dir"
	mkdir -p "$snapshot"
	cp -a "$dir/." "$snapshot/" 2>/dev/null
	mount -t tmpfs tmpfs "$dir"
	cp -a "$snapshot/." "$dir/" 2>/dev/null
	rm -rf "$snapshot"
}

case "$1" in
	start)
		mkdir -p /usr/data/printer_data/config/GuppyScreen/scripts
		seed_tmpfs /opt/printer_data
		seed_tmpfs /usr/data
		# 2026-07-23 (beeper/BAIC4 audio investigation): GuppyScreen's own source
		# (touch_beep.cpp's BEEP_PATH) and guppy_cmd.cfg's [gcode_shell_command
		# guppybeep] both hardcode /usr/data/guppyscreen/guppybeep - the real
		# stock filesystem's actual install path. This project's own Buildroot
		# overlay stages guppyscreen under /opt/guppyscreen instead, and nothing
		# ever bridged the two - both the touch-feedback beep and the M300/BEEP
		# gcode macros were silently failing (execl()/RUN_SHELL_COMMAND hitting
		# a missing binary) on every custom boot until now. /usr/data is fresh
		# tmpfs every boot (seeded above), so this symlink has to be created
		# here, not baked into the read-only squashfs.
		ln -sf /opt/guppyscreen /usr/data/guppyscreen
		;;
	*)
		;;
esac
exit 0
