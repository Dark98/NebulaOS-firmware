+#ifdef CONFIG_TOUCHSCREEN_NS2009_QUALIFICATION
+static const char *ns2009_qual_mode_name(enum ns2009_qual_mode mode)
+{
+	switch (mode) {
+	case NS2009_QUAL_MODE_POLL_ONLY:
+		return "poll-only";
+	case NS2009_QUAL_MODE_IRQ_OBSERVE:
+		return "irq-observe";
+	case NS2009_QUAL_MODE_IRQ_ASSIST:
+		return "irq-assist";
+	}
+	return "unknown";
+}
+
+/* Central, one-way fallback trigger - called from every fail-safe site
+ * below. Idempotent: once permanent_fallback is set, later calls are a
+ * no-op (guaranteeing exactly one warning for the remaining lifetime of
+ * this device instance, never a per-event log). Always restores full,
+ * unconditional 30ms polling - the only touch-reporting path this feature
+ * is ever permitted to leave active once something has gone wrong. */
+static void ns2009_qual_trigger_fallback(struct ns2009_data *data, const char *reason)
+{
+	mutex_lock(&data->qual_lock);
+
+	if (data->qual_permanent_fallback) {
+		mutex_unlock(&data->qual_lock);
+		return;
+	}
+
+	data->qual_permanent_fallback = true;
+	data->qual_fallback_count++;
+	data->qual_fallback_reason = reason;
+
+	if (data->qual_irq_requested && data->qual_irq_armed) {
+		disable_irq_nosync(data->qual_irq);
+		data->qual_irq_armed = false;
+	}
+	data->qual_active_poll = false;
+	data->qual_first_sample_pending = false;
+
+	data->qual_prev_mode = data->qual_mode;
+	data->qual_mode = NS2009_QUAL_MODE_POLL_ONLY;
+	data->qual_mode_transition_count++;
+
+	input_set_poll_interval(data->input, POLL_INTERVAL);
+
+	mutex_unlock(&data->qual_lock);
+
+	dev_warn_ratelimited(&data->client->dev,
+			     "qualification: permanent fallback to poll-only (%s) - "
+			     "polling is unaffected\n", reason);
+}
+
+/* Called once per poll tick, before the existing report logic runs - see
+ * ns2009_diag_on_poll() in the now-superseded touch-poll-diag-gate.patch
+ * for the original of this hook site. */
+static void ns2009_qual_on_poll(struct ns2009_data *data)
+{
+	data->qual_poll_count++;
+
+	if (data->qual_mode == NS2009_QUAL_MODE_IRQ_ASSIST && !data->qual_active_poll)
+		data->qual_safety_poll_count++;
+
+	if (data->qual_first_sample_pending) {
+		data->qual_touch_down_to_first_sample_jiffies =
+			jiffies - data->qual_irq_fire_jiffies;
+		data->qual_first_sample_pending = false;
+	}
+}
+
+/* Called exactly at the existing touch-down transition site, after
+ * data->pen_down has already been set true by the unmodified code above it
+ * - never influences that decision. */
+static void ns2009_qual_on_touch_down(struct ns2009_data *data)
+{
+	data->qual_touch_down_count++;
+
+	/* Sanity/integrity check: by construction of the existing boolean
+	 * pen_down state machine, a down transition can never follow
+	 * another down transition without an intervening release. Escalated
+	 * (vs. TOUCH-D0-DIAG's original read-only counter) to a permanent
+	 * fallback here, per this mission's tighter safety requirements. */
+	if (data->qual_last_transition_was_down) {
+		ns2009_qual_trigger_fallback(data, "inconsistent_transition");
+		return;
+	}
+	data->qual_last_transition_was_down = true;
+
+	/* irq-assist: the safety poll itself caught a new touch-down that
+	 * the IRQ path did not precede (qual_active_poll not already true) -
+	 * the IRQ may have been missed, bounced, or simply not have fired
+	 * yet. Not fatal - the poll path is the authoritative fallback net
+	 * by design - but worth counting, and we still promote to the 30ms
+	 * active cadence so responsiveness for the remainder of this
+	 * contact is no worse than poll-only. */
+	if (data->qual_mode == NS2009_QUAL_MODE_IRQ_ASSIST && !data->qual_active_poll) {
+		data->qual_missed_touch_count++;
+		data->qual_active_poll = true;
+		data->qual_active_poll_start_jiffies = jiffies;
+		data->qual_active_poll_spell_count++;
+		input_set_poll_interval(data->input, POLL_INTERVAL);
+	}
+}
+
+/* Called exactly at the existing release transition site, after
+ * data->pen_down has already been set false by the unmodified code above
+ * it - never influences that decision. */
+static void ns2009_qual_on_touch_release(struct ns2009_data *data)
+{
+	data->qual_release_count++;
+
+	if (!data->qual_last_transition_was_down) {
+		ns2009_qual_trigger_fallback(data, "inconsistent_transition");
+		return;
+	}
+	data->qual_last_transition_was_down = false;
+
+	if (data->qual_mode == NS2009_QUAL_MODE_IRQ_ASSIST && data->qual_active_poll) {
+		int level;
+
+		data->qual_active_poll_total_jiffies +=
+			jiffies - data->qual_active_poll_start_jiffies;
+
+		/* Confirm the release the same, proven way the TOUCH-D0-DIAG
+		 * live qualification run established: GPIO79 idle level is
+		 * HIGH (PROVEN_FROM_LIVE_TEST, see
+		 * docs/NEBULAOS_TOUCH_IRQ_TRIGGER_FINDINGS.md). Anything else
+		 * here means the pin state and the poll-derived pen state
+		 * disagree - not safe to trust the IRQ path further this
+		 * boot. */
+		level = gpiod_get_raw_value_cansleep(data->pendown_gpio);
+		if (level != 1) {
+			ns2009_qual_trigger_fallback(data, "release_confirmation_failed");
+			return;
+		}
+
+		data->qual_active_poll = false;
+		input_set_poll_interval(data->input, NS2009_QUAL_SAFETY_POLL_INTERVAL_MS);
+		if (data->qual_irq_requested && !data->qual_irq_armed) {
+			enable_irq(data->qual_irq);
+			data->qual_irq_armed = true;
+		}
+	}
+}
+
+/* TOUCH-QUALIFICATION: threaded IRQ handler (process context, requested
+ * with a NULL hard-IRQ handler below, so this is the only handler that
+ * ever runs). In BOTH irq-observe and irq-assist this function performs
+ * ZERO I2C transfers and ZERO coordinate/input processing - verifiable
+ * directly by inspection: it contains no i2c_smbus_* call, no
+ * ns2009_ts_report() call, no input_report_*() call. In irq-assist it only
+ * masks the IRQ line and flips the existing poll cadence to 30ms via
+ * input_set_poll_interval() - the actual coordinate/I2C work happens
+ * entirely in the existing, unmodified ns2009_ts_report()/ns2009_ts_poll()
+ * path, in the input core's own poll workqueue, never here. */
+static irqreturn_t ns2009_qual_irq_thread(int irq, void *dev_id)
+{
+	struct ns2009_data *data = dev_id;
+	unsigned long now = jiffies;
+	unsigned long interval;
+
+	if (data->qual_permanent_fallback)
+		return IRQ_HANDLED;
+
+	data->qual_irq_event_count++;
+
+	if (data->qual_last_irq_jiffies) {
+		interval = now - data->qual_last_irq_jiffies;
+		if (data->qual_min_irq_interval_jiffies == 0 ||
+		    interval < data->qual_min_irq_interval_jiffies)
+			data->qual_min_irq_interval_jiffies = interval;
+		if (interval > data->qual_max_irq_interval_jiffies)
+			data->qual_max_irq_interval_jiffies = interval;
+	}
+	data->qual_last_irq_jiffies = now;
+
+	if (data->pen_down)
+		data->qual_irq_events_while_touched++;
+	else
+		data->qual_irq_events_while_idle++;
+
+	/* Storm protection - identical rolling-window shape to the proven
+	 * touch-irq-gate.patch/touch-irq-diag-gate.patch design: a
+	 * permanent, one-way fallback if too many edges land inside one
+	 * rolling window. Applies in both irq-observe and irq-assist. */
+	if (time_before(now, data->qual_storm_window_start +
+			msecs_to_jiffies(NS2009_QUAL_STORM_WINDOW_MS))) {
+		data->qual_storm_window_count++;
+		if (data->qual_storm_window_count > NS2009_QUAL_STORM_THRESHOLD) {
+			disable_irq_nosync(irq);
+			data->qual_irq_armed = false;
+			ns2009_qual_trigger_fallback(data, "irq_storm");
+			return IRQ_HANDLED;
+		}
+	} else {
+		data->qual_storm_window_start = now;
+		data->qual_storm_window_count = 1;
+	}
+
+	if (data->qual_mode != NS2009_QUAL_MODE_IRQ_ASSIST) {
+		/* irq-observe: purely observational cross-reference against
+		 * the existing, unmodified poll-derived pen_down state above
+		 * - nothing else to do. The IRQ naturally re-arms for the
+		 * next falling edge once this handler returns (IRQF_ONESHOT
+		 * unmasks the line again), so no re-arm logic is needed. */
+		return IRQ_HANDLED;
+	}
+
+	/* irq-assist: a repeated fire while a contact is already being
+	 * actively polled means the IRQ line was not successfully masked
+	 * in step with the actual contact state - a real invariant
+	 * violation, not a benign race, so fall back permanently rather
+	 * than risk feeding the active-poll state machine two overlapping
+	 * "contacts". */
+	if (data->qual_active_poll) {
+		disable_irq_nosync(irq);
+		data->qual_irq_armed = false;
+		ns2009_qual_trigger_fallback(data, "repeated_irq_during_contact");
+		return IRQ_HANDLED;
+	}
+
+	/* Mask the line so a held touch cannot keep re-firing (its GPIO
+	 * level simply stays low for the duration of the contact); the
+	 * existing poll/report path takes over at its own normal 30ms
+	 * cadence from here. */
+	disable_irq_nosync(irq);
+	data->qual_irq_armed = false;
+	data->qual_active_poll = true;
+	data->qual_active_poll_start_jiffies = now;
+	data->qual_active_poll_spell_count++;
+	data->qual_irq_fire_jiffies = now;
+	data->qual_first_sample_pending = true;
+	input_set_poll_interval(data->input, POLL_INTERVAL);
+
+	return IRQ_HANDLED;
+}
