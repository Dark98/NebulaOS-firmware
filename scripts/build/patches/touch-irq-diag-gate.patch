+#ifdef CONFIG_TOUCHSCREEN_NS2009_IRQ_DIAG
+static int ns2009_irq_diag_status_show(struct seq_file *s, void *unused)
+{
+	struct ns2009_data *data = s->private;
+
+	seq_printf(s, "irq: %d\n", data->diag_irq);
+	seq_printf(s, "trigger_type: 0x%x\n", data->diag_irq_trigger_type);
+	seq_printf(s, "irq_active: %d\n", data->diag_irq_active);
+	seq_printf(s, "irq_request_failure: %d\n", data->diag_irq_request_failure);
+	seq_printf(s, "event_count: %d\n", atomic_read(&data->diag_irq_event_count));
+	seq_printf(s, "rising_count: %d\n", atomic_read(&data->diag_irq_rising_count));
+	seq_printf(s, "falling_count: %d\n", atomic_read(&data->diag_irq_falling_count));
+	seq_printf(s, "events_while_no_touch: %d\n",
+		   atomic_read(&data->diag_irq_events_while_no_touch));
+	seq_printf(s, "events_while_touch_held: %d\n",
+		   atomic_read(&data->diag_irq_events_while_touch_held));
+	seq_printf(s, "last_irq_jiffies: %lu\n", data->diag_last_irq_jiffies);
+	seq_printf(s, "min_irq_interval_ms: %u\n",
+		   jiffies_to_msecs(data->diag_min_irq_interval_jiffies));
+	seq_printf(s, "max_irq_interval_ms: %u\n",
+		   jiffies_to_msecs(data->diag_max_irq_interval_jiffies));
+	seq_printf(s, "storm_fallback_active: %d\n", data->diag_storm_fallback_active);
+	seq_printf(s, "storm_triggered_count: %d\n",
+		   atomic_read(&data->diag_storm_triggered_count));
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ns2009_irq_diag_status);
+
+/* Best-effort only, same non-fatal contract as
+ * CONFIG_TOUCHSCREEN_NS2009_PENDOWN_IRQ's ns2009_setup_pendown_irq(): any
+ * failure here is logged and left non-fatal - probe() must succeed and
+ * the device must remain fully functional via the unchanged poll alone
+ * regardless of what happens in this function. */
+static void ns2009_irq_diag_setup(struct ns2009_data *data)
+{
+	struct device *dev = &data->client->dev;
+	int irq;
+	int error;
+
+	data->diag_irq_request_failure = 0;
+
+	if (!data->pendown_gpio) {
+		/* No pendown-gpios property at all - nothing to observe. */
+		data->diag_irq_request_failure = -ENODEV;
+		return;
+	}
+
+	irq = gpiod_to_irq(data->pendown_gpio);
+	if (irq < 0) {
+		dev_info(dev,
+			 "IRQ diagnostic: pendown GPIO does not support interrupts (%d) - "
+			 "poll-only, as always\n", irq);
+		data->diag_irq_request_failure = irq;
+		return;
+	}
+
+	data->diag_irq = irq;
+	/* TOUCH-I0-DIAG finalization (2026-08-01): live evidence from
+	 * TOUCH-D0-DIAG's real qualification run (see
+	 * docs/NEBULAOS_TOUCH_IRQ_TRIGGER_FINDINGS.md) classifies GPIO79 as
+	 * IDLE_HIGH_ACTIVE_LOW with moderate-high confidence - zero invariant
+	 * violations across 78 real touch events on real hardware, across
+	 * two boots. Touch-down is therefore a HIGH-to-LOW transition: a
+	 * falling edge. Per the mission's own guidance ("prefer a
+	 * touch-down-only trigger when it can be safely re-armed after
+	 * release"), this now requests FALLING only, not both edges - the
+	 * IRQ naturally re-arms for the next falling edge once the threaded
+	 * handler completes (IRQF_ONESHOT unmasks the line again after the
+	 * handler returns), so no explicit re-arm-after-release logic is
+	 * needed. Release detection itself remains the poll path's job,
+	 * unchanged - this diagnostic only observes touch-down IRQ timing,
+	 * it never reports release. The specific active-LOW polarity is
+	 * SUPPORTED_INFERENCE (by elimination, not a raw-level sample taken
+	 * synchronized to an in-progress touch) - if a future run's evidence
+	 * ever contradicts this, this trigger selection must be revisited,
+	 * not assumed permanent. */
+	data->diag_irq_trigger_type = IRQF_TRIGGER_FALLING;
+	data->diag_storm_window_start = jiffies;
+	data->diag_storm_window_count = 0;
+
+	error = devm_request_threaded_irq(dev, irq, NULL, ns2009_irq_diag_thread,
+					   data->diag_irq_trigger_type | IRQF_ONESHOT,
+					   "ns2009-irq-diag", data);
+	if (error) {
+		dev_info(dev,
+			 "IRQ diagnostic: could not request IRQ %d (%d) - "
+			 "poll-only, as always\n", irq, error);
+		data->diag_irq_request_failure = error;
+		return;
+	}
+
+	data->diag_irq_active = true;
+	dev_info(dev, "IRQ diagnostic: IRQ %d active for observation only "
+		 "(poll remains the sole touch-reporting path)\n", irq);
+
+	data->diag_irq_debugfs_dir = debugfs_create_dir("ns2009_ts_irq_diag", NULL);
+	if (!IS_ERR_OR_NULL(data->diag_irq_debugfs_dir))
+		debugfs_create_file("status", 0444, data->diag_irq_debugfs_dir, data,
+				     &ns2009_irq_diag_status_fops);
+}
+#endif
+
 static int ns2009_ts_probe(struct i2c_client *client)
 {
 	struct ns2009_data *data;
@@ -227,6 +468,13 @@ static int ns2009_ts_probe(struct i2c_client *client)
