# Large third-party source trees fetched for reference/build purposes.
# Provenance/exact commit is recorded in FIRMWARE.md - not committed here,
# re-clone from the URLs there if this workspace moves.
/vendor/
__pycache__/
*.pyc

# Build OUTPUT, not source - scripts/build/00 through 05 reproduce these
# exactly (see scripts/build/README.md). rootfs.ext2 alone is ~400MB, over
# GitHub's 100MB per-file push limit, and re-committing it every build cycle
# bloated .git substantially. The small config files alongside them
# (buildroot.config, kernel.config, halley5-nebulaos-fragment.config,
# halley5_v30.dts) stay tracked - human-readable, worth keeping in history.
artifacts/buildroot-halley5-v30-image/rootfs.ext2
artifacts/buildroot-halley5-v30-image/rootfs.squashfs
artifacts/buildroot-halley5-v30-image/xImage
# Stale pre-v30 board target, same reasoning.
artifacts/buildroot-halley5-image/rootfs.ext2
artifacts/buildroot-halley5-image/uImage

# Proprietary Cypress/Broadcom WiFi firmware + board NVRAM. Redistribution
# is now explicitly authorized (see LICENSES/WIFI-FIRMWARE-NOTICE.md) and
# 00-fetch-vendor-sources.sh downloads+verifies them automatically from this
# repo's own wifi-firmware-v1.0.0 GitHub Release - not committed directly
# here for the same reason rootfs.ext2/xImage above aren't (real binary
# build/fetch output, not source; a version bump is a reviewable release,
# not a git-history binary diff). scripts/build/fetch-wifi-firmware.sh still
# exists if you'd rather re-derive fresh copies from your own stock device.
scripts/build/overlay/lib/firmware/brcm/brcmfmac43430-sdio.bin
scripts/build/overlay/lib/firmware/brcm/brcmfmac43430-sdio.txt
/vendor-downloads/

# CLM blob for the same chip - Cypress's own LICENCE.cypress EULA (not
# ISC like wireless-regdb below), fetched-and-verified by
# scripts/firmware/fetch-linux-firmware-clm.sh from the same public
# linux-firmware distribution Buildroot's own package already pins -
# same "fetch at build time, never a committed binary" treatment as the
# proprietary WiFi firmware above.
scripts/build/overlay/lib/firmware/brcm/brcmfmac43430-sdio.clm_blob
scripts/build/overlay/lib/firmware/brcm/brcmfmac43430-sdio.clm_blob.LICENCE

# wireless-regdb (ISC-licensed, but still fetched-and-verified rather than
# committed, so a version bump is a reviewable diff to the fetch script, not
# a silent binary swap in git history) - scripts/firmware/fetch-wireless-regdb.sh.
# Re-run after a fresh checkout.
scripts/build/overlay/lib/firmware/regulatory.db
scripts/build/overlay/lib/firmware/regulatory.db.p7s
scripts/build/overlay/lib/firmware/regulatory.db.LICENSE

# build-stage exclusive lock (scripts/build/0[2-5]-*.sh) - local, per-checkout
.nebulaos-build.lock

# 04-cross-compile-app-stack.sh's own scratch dir - downloaded pywheels and
# extracted tarballs, pure build output like vendor/.
/build-work/

# Cross-compiled MIPS binary - build output, not source. Source
# (fb-vsync-test.c) stays tracked; rebuild via the MIPS toolchain per
# tools/fb-vsync-test/README.md.
tools/fb-vsync-test/fb-vsync-test
