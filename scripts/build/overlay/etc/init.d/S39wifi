#!/bin/sh
#
# OpenKE addition (FIRMWARE.md sec 17/18): starts wpa_supplicant on wlan0
# against real credentials. Numbered S39 - runs before S40network's
# `ifup -a`, so wlan0 has already associated by the time udhcpc tries it
# (this script also explicitly re-runs `ifup wlan0` itself after associating,
# as a real belt-and-suspenders rather than relying on ordering alone).
#
# ctrl_interface=/var/run/wpa_supplicant in the config already matches what
# GuppyScreen's own guppyconfig.json expects for its WiFi panel.
#
# Lives under /usr/data/openke/ (S01persistent-datastore) rather than
# /usr/data/wpa_supplicant.conf directly - real, persistent storage now
# (mmcblk0p10), kept in this build's own isolated subdirectory rather than
# the shared partition's top level, same as everything else this build owns.

CONF=/usr/data/openke/wpa_supplicant.conf
PIDFILE=/var/run/wpa_supplicant-wlan0.pid

start() {
	if [ ! -f "$CONF" ]; then
		echo "S45wifi: $CONF not present, skipping"
		return 0
	fi
	echo "Starting wpa_supplicant on wlan0"
	mkdir -p /var/run/wpa_supplicant
	start-stop-daemon -S -b -m -p "$PIDFILE" \
		-x /usr/sbin/wpa_supplicant -- \
		-i wlan0 -c "$CONF"
	sleep 2
	/sbin/ifup wlan0 2>/dev/null
}

stop() {
	echo "Stopping wpa_supplicant"
	/sbin/ifdown wlan0 2>/dev/null
	start-stop-daemon -K -p "$PIDFILE"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
