 /* polling interval in ms */
 #define POLL_INTERVAL	30
 
+#ifdef CONFIG_TOUCHSCREEN_NS2009_POLL_DIAG
+/* TOUCH-D0-DIAG (display/touch investigation mission follow-on,
+ * 2026-08-01+): a purely additive, read-only diagnostic layered on top of
+ * the existing, unmodified 30ms poll below - see the block comments next
+ * to each hook site for exactly what each counter means. Nothing in this
+ * block changes poll interval, coordinate reads, calibration, filtering,
+ * or input event reporting - it only observes and counts. A contact
+ * shorter than this window (or a re-touch arriving this soon after a
+ * release) is classified as bounce, never as a deliberate new touch. */
+#define NS2009_DIAG_BOUNCE_WINDOW_MS	60
+/* Sentinel meaning "no completed contact observed yet". */
+#define NS2009_DIAG_DURATION_UNSET	((unsigned long)-1)
+#endif
+
 /* this driver uses 12-bit readout */
 #define MAX_12BIT	0xfff
 
@@ -62,6 +82,27 @@ struct ns2009_data {
 	 * generic upstream Z1-threshold-only behavior unchanged for any other
 	 * board using this driver. */
 	struct gpio_desc		*pendown_gpio;
+
+#ifdef CONFIG_TOUCHSCREEN_NS2009_POLL_DIAG
+	/* TOUCH-D0-DIAG: purely additive to the fields above, never
+	 * replacing them - see the CONFIG_TOUCHSCREEN_NS2009_POLL_DIAG
+	 * block comment near POLL_INTERVAL for the full design rationale.
+	 * All in-memory only, never logged per-poll. */
+	u64				diag_poll_count;
+	u64				diag_touch_down_count;
+	u64				diag_release_count;
+	u64				diag_unexpected_transition_count;
+	u64				diag_bounce_count;
+	int				diag_raw_level;		/* -1 unknown/no gpio */
+	u64				diag_raw_high_count;
+	u64				diag_raw_low_count;
+	bool				diag_last_transition_was_down;
+	unsigned long			diag_last_down_jiffies;
+	unsigned long			diag_last_up_jiffies;
+	unsigned long			diag_min_contact_duration_ms;
+	unsigned long			diag_max_contact_duration_ms;
+	struct dentry			*diag_debugfs_dir;
+#endif
 };
 
 static int ns2009_ts_read_data(struct ns2009_data *data, u8 cmd, u16 *val)
@@ -81,6 +122,91 @@ static int ns2009_ts_read_data(struct ns2009_data *data, u8 cmd, u16 *val)
 	return 0;
 }
 
+#ifdef CONFIG_TOUCHSCREEN_NS2009_POLL_DIAG
+/* Called once per poll tick, before the existing report logic runs -
+ * counts the tick and, when a pendown-gpios property exists, additionally
+ * takes one extra READ-ONLY raw (pre-active_low) sample of the same pin
+ * via gpiod_get_raw_value_cansleep(), independent of the logical value
+ * the existing code already derives via gpiod_get_value_cansleep(). This
+ * never writes to the pin and never changes which value the existing
+ * code uses to decide pen_is_down - it exists purely so a human can see
+ * the true electrical level distribution (raw_level/idle_level below)
+ * without having to trust the driver's own active-low assumption. */
+static void ns2009_diag_on_poll(struct ns2009_data *data)
+{
+	int raw;
+
+	data->diag_poll_count++;
+
+	if (!data->pendown_gpio)
+		return;
+
+	raw = gpiod_get_raw_value_cansleep(data->pendown_gpio);
+	data->diag_raw_level = raw;
+	if (raw)
+		data->diag_raw_high_count++;
+	else
+		data->diag_raw_low_count++;
+}
+
+/* Called exactly at the existing touch-down transition site, after
+ * data->pen_down has already been set true by the unmodified code above
+ * it - never influences that decision. */
+static void ns2009_diag_on_touch_down(struct ns2009_data *data)
+{
+	unsigned long now = jiffies;
+
+	data->diag_touch_down_count++;
+
+	/* Bounce heuristic: a down transition arriving very soon after the
+	 * previous release is classified as contact bounce, not a
+	 * deliberate new touch. Purely a classification counter - never
+	 * alters what gets reported to userspace. */
+	if (data->diag_release_count > 0 &&
+	    time_before(now, data->diag_last_up_jiffies +
+			msecs_to_jiffies(NS2009_DIAG_BOUNCE_WINDOW_MS)))
+		data->diag_bounce_count++;
+
+	/* Sanity/integrity check only: by construction of the existing
+	 * boolean pen_down state machine, a down transition can never
+	 * follow another down transition without an intervening release.
+	 * This should always remain 0 - it exists purely as defense in
+	 * depth in case this code is ever refactored in a way that breaks
+	 * that invariant. */
+	if (data->diag_last_transition_was_down)
+		data->diag_unexpected_transition_count++;
+	data->diag_last_transition_was_down = true;
+
+	data->diag_last_down_jiffies = now;
+}
+
+/* Called exactly at the existing release transition site, after
+ * data->pen_down has already been set false by the unmodified code above
+ * it - never influences that decision. */
+static void ns2009_diag_on_touch_release(struct ns2009_data *data)
+{
+	unsigned long now = jiffies;
+	unsigned long duration_ms = jiffies_to_msecs(now - data->diag_last_down_jiffies);
+
+	data->diag_release_count++;
+
+	if (duration_ms < NS2009_DIAG_BOUNCE_WINDOW_MS)
+		data->diag_bounce_count++;
+
+	if (data->diag_min_contact_duration_ms == NS2009_DIAG_DURATION_UNSET ||
+	    duration_ms < data->diag_min_contact_duration_ms)
+		data->diag_min_contact_duration_ms = duration_ms;
+	if (duration_ms > data->diag_max_contact_duration_ms)
+		data->diag_max_contact_duration_ms = duration_ms;
+
+	if (!data->diag_last_transition_was_down)
+		data->diag_unexpected_transition_count++;
+	data->diag_last_transition_was_down = false;
+
+	data->diag_last_up_jiffies = now;
+}
+#endif
