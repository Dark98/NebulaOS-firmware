diff --git a/kernel/kernel-6.6/module_drivers/drivers/misc/nebulaos_backlight_probe_diag.c b/kernel/kernel-6.6/module_drivers/drivers/misc/nebulaos_backlight_probe_diag.c
new file mode 100644
index 000000000..38d079278
--- /dev/null
+++ b/kernel/kernel-6.6/module_drivers/drivers/misc/nebulaos_backlight_probe_diag.c
@@ -0,0 +1,920 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NebulaOS bounded backlight probe diagnostic (DISPLAY-B0-DIAG)
+ *
+ * Display hardware analysis mission follow-on (2026-08-01+) - see
+ * docs/NEBULAOS_DISPLAY_OFFLINE_IMPLEMENTATION_PLAN.md,
+ * docs/NEBULAOS_BACKLIGHT_DIAGNOSTIC_PLAN.md and
+ * build-work/display-analysis/backlight-path-analysis.txt.
+ *
+ * Purpose: let a human safely discover the real backlight PWM channel/
+ * frequency/enable-GPIO behavior on this board without any external
+ * measurement equipment, entirely through kernel-owned, self-restoring,
+ * time-bounded probes issued via a tightly-scoped debugfs command
+ * interface - never raw /dev/mem, never unrestricted GPIO/PWM sysfs.
+ *
+ * Candidate hardware (HYPOTHESES ONLY, not proven facts - see
+ * backlight-path-analysis.txt for the full evidence trail):
+ *   - PWM channel 0 (GPC-0 / pwm0_pc), period 20000ns (~50kHz, matching
+ *     stock's own pwm_backlight.sh pwm_freq=50000)
+ *   - a separate enable GPIO around PC22 (stock's own power_gpio)
+ * This driver treats both purely as candidates to probe - it never
+ * assumes either is correct, and it never touches either at module
+ * load/bind time. Probing is 100% opt-in via debugfs. The debugfs
+ * command interface exposes NO channel/GPIO-number argument at all -
+ * every probe always acts on exactly these two fixed hardware handles
+ * (diag->pwm / diag->enable_gpio), each acquired exactly once, in
+ * nebulaos_bl_diag_probe() below, via devm_pwm_get(dev, NULL) (the
+ * DT node's sole "pwms" entry) and devm_gpiod_get_optional(dev,
+ * "enable", ...) (the DT node's "enable-gpios" property by name). There
+ * is no code path anywhere in this file that parses a user-supplied
+ * channel or GPIO number - an arbitrary channel/GPIO can never be
+ * requested through this interface even in principle.
+ *
+ * COMMAND WHITELIST (command-interface hardening pass, 2026-08-xx): the
+ * debugfs .../command interface accepts EXACTLY these 9 literal strings
+ * and nothing else - each takes zero arguments, and any trailing token
+ * after the command word is rejected with -EINVAL, not silently ignored:
+ *
+ *   status              read-only, dumps status via dev_info() too
+ *   arm                 diagnostic-level gate: allow probe-* below
+ *   disarm              diagnostic-level gate: forbid probe-* below,
+ *                       force-restores any still-active probe first
+ *   probe-enable-low    drive the candidate enable-gpio logical low
+ *   probe-enable-high   drive the candidate enable-gpio logical high
+ *   probe-pwm-25        drive the candidate PWM to 25% duty
+ *   probe-pwm-50        drive the candidate PWM to 50% duty
+ *   probe-pwm-75        drive the candidate PWM to 75% duty
+ *   restore             cancel any active probe and restore immediately
+ *                       (always allowed, even while disarmed - this is
+ *                       the safety escape hatch, never gated)
+ *
+ * This intentionally REMOVES the earlier prototype's free-form
+ * "probe <kind> <value> [timeout_ms]" grammar. There is no longer any
+ * code path in this file that parses an arbitrary GPIO number, PWM
+ * channel, duty cycle, period, MMIO address, or timeout from user input:
+ * the 5 probe-* commands are fixed literals that each map to exactly one
+ * compile-time-known (gpio_val|duty_pct) pair, and every probe now always
+ * uses the fixed NEBULAOS_BL_DIAG_DEFAULT_TIMEOUT_MS duration - see
+ * nebulaos_bl_diag_cmd_probe()'s static_assert for why a caller-supplied
+ * timeout is no longer even representable, not merely bounds-checked.
+ * 0%/100% duty and persistent/unbounded probe mode were never expressible
+ * before this pass either and remain impossible now for the same reason:
+ * they are not among the fixed literals this parser recognizes.
+ *
+ * Mandatory safety behavior, for every probe command:
+ *   - a probe is rejected outright (-EPERM) unless the diagnostic has
+ *     been explicitly armed first via the "arm" command - "disarmed" is
+ *     the default at every boot (see nebulaos_bl_diag_probe()) and after
+ *     every "disarm", so no probe can ever run without an explicit,
+ *     separate opt-in beyond just writing the probe command itself.
+ *   - a probe is rejected outright (-EOPNOTSUPP) unless the specific
+ *     resource it would touch currently has an EXACT restoration path -
+ *     see "PWM-EXACTNESS GATE" below. This is a genuine, live capability
+ *     check, never a hardcoded answer.
+ *   - probe() only ever *reads* the PWM/GPIO state already present at
+ *     bind time - it never calls pwm_apply_state()/
+ *     gpiod_direction_output() itself, so binding this driver can never
+ *     change what the panel is currently doing. (See the "RESTORATION
+ *     EXACTNESS" section below for an important, honest caveat about
+ *     what this "read" actually captures for the PWM side.)
+ *   - exactly one probe may be active at a time - a second "probe-*"
+ *     command while one is already active is rejected outright (-EBUSY),
+ *     no hardware is touched by the rejected command.
+ *   - every probe applies exactly one temporary state (either the
+ *     candidate enable-gpio to a requested level, or the candidate PWM
+ *     to a requested duty cycle - never both at once).
+ *   - ARM-BEFORE-APPLY ORDERING (load-bearing - do not reorder; "arm"
+ *     here means arming the kernel watchdog timer, a different concept
+ *     from the diagnostic-level "arm"/"disarm" commands above - see the
+ *     per-probe struct field names, which spell out "watchdog" or
+ *     "diag_armed" explicitly to avoid the two senses colliding): every
+ *     probe command (1) captures the prior state, (2) marks the probe
+ *     active and schedules the kernel-owned restore_work timer, and
+ *     ONLY THEN (3) applies the one candidate state to hardware. This
+ *     order is deliberate: if anything crashes/oopses/is killed between
+ *     steps (2) and (3), the watchdog is already armed and will simply
+ *     fire and restore against the saved state that was captured before
+ *     any hardware write happened (a harmless no-op, since nothing was
+ *     ever actually applied). The reverse order (apply, then arm) would
+ *     leave a real window where a crash between "apply" and "arm" leaves
+ *     hardware in the probed state with NO watchdog covering it - that
+ *     bug existed in an earlier revision of this driver and was fixed
+ *     here. If the hardware-apply step itself fails (pwm_apply_state()
+ *     returning an error - gpiod_set_raw_value_cansleep() cannot fail),
+ *     the probe state and the just-armed timer are unwound synchronously
+ *     before returning the error, so a probe that never actually took
+ *     effect can never trigger a spurious restore later.
+ *   - a kernel workqueue timer (delayed_work), armed (per the ordering
+ *     above) at probe start, always auto-restores the saved state after
+ *     a fixed NEBULAOS_BL_DIAG_DEFAULT_TIMEOUT_MS timeout - this is
+ *     entirely independent of any userspace process's lifetime. A
+ *     dropped SSH session, a killed shell, or a signal delivered to
+ *     whatever process issued the probe command cannot prevent this from
+ *     firing: the workqueue callback is scheduled against the kernel's
+ *     own timer wheel, not against any file descriptor or process this
+ *     driver ever holds a reference to.
+ *   - an explicit "restore" command cancels that timer and restores
+ *     immediately, synchronously. So does "disarm".
+ *   - 0% and 100% duty-cycle requests can never be constructed through
+ *     this interface at all - only the fixed "probe-pwm-25/50/75"
+ *     literals exist, so an unproven or wrong polarity/wiring assumption
+ *     can never drive the candidate PWM fully on or fully off through
+ *     this diagnostic.
+ *   - there is no persistent/unbounded probe mode: every probe always
+ *     uses the fixed NEBULAOS_BL_DIAG_DEFAULT_TIMEOUT_MS duration; there
+ *     is no way to request "no timeout" or an arbitrarily large one.
+ *   - driver remove() forces an immediate, synchronous restore if a
+ *     probe is still active, so unbinding never leaves hardware in a
+ *     probed (non-original) state.
+ *
+ * RESTORATION EXACTNESS - read this before trusting any "restore" claim:
+ *
+ *   GPIO side (candidate enable-gpios, if present): EXACT. This board's
+ *   pinctrl-ingenic gpio_chip's .get callback (ingenic_gpio_get(), in
+ *   module_drivers/drivers/pinctrl/pinctrl-ingenic.c) reads the live
+ *   PxPIN hardware register on every single call - both the initial
+ *   capture in nebulaos_bl_diag_probe() and the per-probe capture in
+ *   nebulaos_bl_diag_cmd_probe() are genuine hardware readbacks, not a
+ *   cached/assumed value. Restoring to that captured value is a real,
+ *   exact restoration of the pin's actual prior electrical level.
+ *
+ *   PWM side (candidate PWM channel): EXACTNESS NOW DEPENDS ON A LIVE
+ *   CAPABILITY QUERY, NOT A HARDCODED ANSWER. This board's bound PWM
+ *   driver (module_drivers/drivers/pwm/pwm-ingenic-v2.c) historically
+ *   implemented only the .apply callback in its "struct pwm_ops" - no
+ *   .get_state, meaning pwm_get_state() could never return real hardware
+ *   content and any "restore" was necessarily a safe-default guess, not
+ *   an exact reconstruction. The NebulaOS PWM state readback patch (see
+ *   scripts/build/patches/pwm-ingenic-v2-get-state.patch and
+ *   docs/NEBULAOS_PWM_STATE_READBACK_REPORT.md) added a real .get_state
+ *   implementation gated behind CONFIG_PWM_INGENIC_V2_GET_STATE (default
+ *   n), plus an exported capability query,
+ *   ingenic_pwm_channel_get_state_is_exact(chip, channel), that reports
+ *   whether THIS channel's readback is exact right now (true for
+ *   COMMON_MODE - the default; false for DMA_MODE, which has no simple
+ *   duty/period register to decode).
+ *
+ *   PWM-EXACTNESS GATE (closes the two TODOs formerly here - see
+ *   nebulaos_bl_diag_pwm_restore_is_exact() below): every PWM probe
+ *   request now calls that exported query for the exact candidate
+ *   channel it is about to touch, before arming or applying anything,
+ *   and is rejected outright (-EOPNOTSUPP) if it does not report exact.
+ *   This is a genuine, live branch on the real function's return value -
+ *   never a constant. When CONFIG_PWM_INGENIC_V2_GET_STATE is NOT
+ *   selected (the project-wide default - neither PWM readback nor this
+ *   diagnostic is qualified for a production/active-slot build yet), the
+ *   capability simply does not exist to query, so the gate conservatively
+ *   reports "not exact" and every PWM probe is refused - the fallback is
+ *   always "refuse to arm", never "assume exact". This is surfaced at
+ *   runtime, not just decided silently: the debugfs .../status file's
+ *   "pwm_restore_is_exact" field now reports this driver's own live
+ *   answer to the same query, for the same channel, every time it is
+ *   read - it is no longer a documentation-only floor value.
+ *
+ * Bounded debugfs command interface (write to .../command) - see the
+ * "COMMAND WHITELIST" section above for the authoritative list.
+ *
+ * NEVER enable CONFIG_NEBULAOS_BACKLIGHT_PROBE_DIAG for a production/
+ * active-slot build - see scripts/build/display-backlight-diag-variant.sh
+ * and docs/NEBULAOS_DISPLAY_LIVE_QUALIFICATION_PLAN.md.
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/of.h>
+#include <linux/pwm.h>
+#include <linux/gpio/consumer.h>
+#include <linux/debugfs.h>
+#include <linux/seq_file.h>
+#include <linux/workqueue.h>
+#include <linux/jiffies.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <linux/build_bug.h>
+
+#define NEBULAOS_BL_DIAG_NAME			"nebulaos_backlight_diag"
+/* Bounds mandated by the display hardware analysis mission's hardening
+ * pass: every probe now ALWAYS uses exactly DEFAULT_TIMEOUT_MS (see the
+ * file header "COMMAND WHITELIST" section - there is no longer any
+ * caller-supplied timeout argument at all). MIN/MAX remain as the
+ * compile-time bounds nebulaos_bl_diag_cmd_probe()'s static_assert checks
+ * DEFAULT against, so a future edit can never silently push the fixed
+ * duration outside the mission's [250ms, 3000ms] envelope. */
+#define NEBULAOS_BL_DIAG_DEFAULT_TIMEOUT_MS	2000
+#define NEBULAOS_BL_DIAG_MIN_TIMEOUT_MS		250
+#define NEBULAOS_BL_DIAG_MAX_TIMEOUT_MS		3000
+/* Candidate period only - see backlight-path-analysis.txt. Never proven
+ * correct for this board's real backlight circuit, only a documented,
+ * stock-matching starting point. */
+#define NEBULAOS_BL_DIAG_CANDIDATE_PERIOD_NS	20000
+
+/*
+ * Cross-module capability query exported by pwm-ingenic-v2.c (NebulaOS PWM
+ * state readback patch - see
+ * scripts/build/patches/pwm-ingenic-v2-get-state.patch and
+ * docs/NEBULAOS_PWM_STATE_READBACK_REPORT.md). No shared header exists for
+ * that driver's exported symbols - its own definition site carries an
+ * identical forward declaration immediately above its own
+ * EXPORT_SYMBOL_GPL(ingenic_pwm_channel_get_state_is_exact) line, solely
+ * to satisfy -Wmissing-prototypes; this mirrors that same direct-extern
+ * convention here on the consumer side rather than introducing a new
+ * module_drivers/include/ header for a single one-line declaration.
+ * Guarded by #ifdef (not just #if) so the symbol reference itself is
+ * compiled out - not merely dead-code-eliminated - when
+ * CONFIG_PWM_INGENIC_V2_GET_STATE is unselected, which is required: that
+ * symbol plainly does not exist to link against in that configuration
+ * (pwm-ingenic-v2.c only defines/exports it inside its own matching
+ * #ifdef block). The two Kconfig options are otherwise fully independent -
+ * see nebulaos_bl_diag_pwm_restore_is_exact()'s #else branch for the safe
+ * fallback when this one is off.
+ */
+#ifdef CONFIG_PWM_INGENIC_V2_GET_STATE
+extern bool ingenic_pwm_channel_get_state_is_exact(struct pwm_chip *chip, unsigned int channel);
+#endif
+
+enum nebulaos_bl_diag_probe_type {
+	NEBULAOS_BL_DIAG_PROBE_NONE = 0,
+	NEBULAOS_BL_DIAG_PROBE_ENABLE_GPIO,
+	NEBULAOS_BL_DIAG_PROBE_PWM_DUTY,
+};
+
+struct nebulaos_bl_diag {
+	struct device			*dev;
+	struct pwm_device		*pwm;
+	struct gpio_desc		*enable_gpio;
+
+	/* Serializes every command handler and the restore path against
+	 * each other. Never held across cancel_delayed_work_sync() - see
+	 * nebulaos_bl_diag_cmd_restore()/_remove() for why that ordering
+	 * matters (the delayed_work callback itself also takes this lock;
+	 * calling the synchronous cancel while holding it would deadlock
+	 * against a concurrently-running watchdog restore). */
+	struct mutex			lock;
+	struct delayed_work		restore_work;
+
+	/* Diagnostic-level gate, distinct from "a probe's kernel watchdog
+	 * timer is armed" below - controlled only by the "arm"/"disarm"
+	 * debugfs commands, always false at boot (see
+	 * nebulaos_bl_diag_probe()) and after every "disarm". A probe-*
+	 * command is rejected with -EPERM whenever this is false. */
+	bool				diag_armed;
+
+	bool				probe_active;
+	enum nebulaos_bl_diag_probe_type probe_type;
+	int				requested_duty_pct;	/* -1 if n/a */
+	unsigned long			requested_period_ns;
+	int				candidate_gpio_state;	/* -1 if unknown/absent */
+	unsigned long			probe_deadline;		/* jiffies */
+	unsigned int			active_timeout_ms;
+
+	struct pwm_state		saved_pwm_state;
+	int				saved_gpio_value;	/* -1 if no gpio present */
+
+	unsigned int			restore_count;			/* explicit "restore"/"disarm" */
+	unsigned int			watchdog_restoration_count;	/* timeout-triggered */
+	unsigned int			probe_failure_count;		/* rejected/failed probes */
+
+	struct dentry			*debugfs_dir;
+};
+
+/*
+ * Whether restoring the candidate PWM channel right now would be an EXACT
+ * hardware readback, per the real, live exported capability query - see
+ * the file header "PWM-EXACTNESS GATE" section. This genuinely branches on
+ * ingenic_pwm_channel_get_state_is_exact()'s real return value whenever
+ * that query is actually linkable (CONFIG_PWM_INGENIC_V2_GET_STATE
+ * selected) and the PWM device this driver bound at probe() time is
+ * actually owned by that same driver (checked via the bound chip's own
+ * platform driver name, "ingenic-pwm" - see pwm-ingenic-v2.c's
+ * ingenic_pwm_driver.driver.name - never assumed). Falls back to "not
+ * exact" - never "exact" - in every other case: config not selected, chip
+ * pointer unexpectedly absent, or chip identity mismatch. This function is
+ * the single source of truth nebulaos_bl_diag_cmd_probe() and the debugfs
+ * status output both consult - neither ever hardcodes an answer.
+ */
+static bool nebulaos_bl_diag_pwm_restore_is_exact(struct nebulaos_bl_diag *diag)
+{
+#ifdef CONFIG_PWM_INGENIC_V2_GET_STATE
+	struct pwm_chip *chip;
+
+	if (!diag->pwm)
+		return false;
+	chip = diag->pwm->chip;
+	if (!chip || !chip->dev || !chip->dev->driver || !chip->dev->driver->name)
+		return false;
+	/* Defensive identity check: only ever trust this query against the
+	 * chip it was actually written for. A generic PWM consumer has no
+	 * other safe way to confirm a struct pwm_chip * is really this
+	 * driver's own struct ingenic_pwm_chip embedding it (to_ingenic_chip()
+	 * inside pwm-ingenic-v2.c does a container_of() cast that is only
+	 * safe for a chip that really is one). */
+	if (strcmp(chip->dev->driver->name, "ingenic-pwm"))
+		return false;
+	return ingenic_pwm_channel_get_state_is_exact(chip, diag->pwm->hwpwm);
+#else
+	/* CONFIG_PWM_INGENIC_V2_GET_STATE not selected: this board's bound
+	 * PWM driver may implement no .get_state callback at all (see the
+	 * file header "RESTORATION EXACTNESS" section), so there is no
+	 * capability query to consult here even in principle. Conservatively
+	 * treat every channel as NOT exact - never assume exact when the
+	 * readback capability is simply unavailable to check. This is the
+	 * mandatory safe fallback: "refuse to arm", never "assume exact". */
+	return false;
+#endif
+}
+
+/*
+ * Whether restoring the candidate enable-gpio right now would be an exact
+ * hardware readback. Unlike the PWM side, this has been true unconditionally
+ * since the original prototype (see the file header "RESTORATION EXACTNESS"
+ * section: pinctrl-ingenic.c's gpio_chip .get callback reads the live PxPIN
+ * register on every call) - restated here as its own function purely so the
+ * PWM-exactness gate and the GPIO-exactness fact share one uniform call
+ * shape via nebulaos_bl_diag_probe_type_restore_is_exact() below.
+ */
+static bool nebulaos_bl_diag_gpio_restore_is_exact(struct nebulaos_bl_diag *diag)
+{
+	return diag->enable_gpio != NULL;
+}
+
+/* Dispatches to the correct per-resource exactness check above for
+ * whichever probe type is being requested. Used both by the arm/probe
+ * refusal gate in nebulaos_bl_diag_cmd_probe() and by the debugfs status
+ * output, so both always report/enforce the identical, real answer. */
+static bool nebulaos_bl_diag_probe_type_restore_is_exact(struct nebulaos_bl_diag *diag,
+							   enum nebulaos_bl_diag_probe_type type)
+{
+	switch (type) {
+	case NEBULAOS_BL_DIAG_PROBE_ENABLE_GPIO:
+		return nebulaos_bl_diag_gpio_restore_is_exact(diag);
+	case NEBULAOS_BL_DIAG_PROBE_PWM_DUTY:
+		return nebulaos_bl_diag_pwm_restore_is_exact(diag);
+	default:
+		return false;
+	}
+}
+
+/* Always call with diag->lock held. No-op if no probe is currently
+ * active (safe to call speculatively from both the explicit-restore path
+ * and the watchdog path without either needing to prove the other didn't
+ * already run first). */
+static void nebulaos_bl_diag_do_restore(struct nebulaos_bl_diag *diag, bool is_watchdog)
+{
+	int ret;
+
+	if (!diag->probe_active)
+		return;
+
+	if (diag->probe_type == NEBULAOS_BL_DIAG_PROBE_PWM_DUTY) {
+		/* See the file header "RESTORATION EXACTNESS" section: this
+		 * reapplies whatever nebulaos_bl_diag_cmd_probe() captured
+		 * via pwm_get_state() before probing. Whether that capture
+		 * was itself a genuine hardware readback depends on
+		 * nebulaos_bl_diag_pwm_restore_is_exact() at the time the
+		 * probe was accepted - the gate already refused this probe
+		 * outright unless that reported true, so reaching this point
+		 * with probe_type == PWM_DUTY at all means the captured state
+		 * this reapplies WAS a genuine hardware readback. */
+		ret = pwm_apply_state(diag->pwm, &diag->saved_pwm_state);
+		if (ret)
+			dev_err(diag->dev,
+				"restore: failed to reapply saved PWM state: %d\n", ret);
+	} else if (diag->probe_type == NEBULAOS_BL_DIAG_PROBE_ENABLE_GPIO) {
+		/* Genuine hardware readback captured pre-probe - see the
+		 * file header "RESTORATION EXACTNESS" section. */
+		if (diag->enable_gpio && diag->saved_gpio_value >= 0)
+			gpiod_set_raw_value_cansleep(diag->enable_gpio,
+						      diag->saved_gpio_value);
+	}
+
+	diag->probe_active = false;
+	diag->probe_type = NEBULAOS_BL_DIAG_PROBE_NONE;
+	diag->requested_duty_pct = -1;
+	diag->requested_period_ns = 0;
+
+	if (is_watchdog)
+		diag->watchdog_restoration_count++;
+	else
+		diag->restore_count++;
+}
+
+/* The kernel-owned watchdog: scheduled at the fixed
+ * NEBULAOS_BL_DIAG_DEFAULT_TIMEOUT_MS duration whichever probe command
+ * started it, entirely independent of any userspace process. Runs on the
+ * system workqueue - it fires whether or not anything ever issues an
+ * explicit "restore"/"disarm", and whether or not the process that issued
+ * the original probe command is still alive. */
+static void nebulaos_bl_diag_restore_work(struct work_struct *work)
+{
+	struct nebulaos_bl_diag *diag = container_of(to_delayed_work(work),
+						      struct nebulaos_bl_diag,
+						      restore_work);
+
+	mutex_lock(&diag->lock);
+	nebulaos_bl_diag_do_restore(diag, true);
+	mutex_unlock(&diag->lock);
+}
+
+static int nebulaos_bl_diag_cmd_restore(struct nebulaos_bl_diag *diag)
+{
+	/* Cancel the watchdog BEFORE taking diag->lock - the watchdog
+	 * callback also takes diag->lock, so canceling synchronously while
+	 * already holding it here could deadlock against a watchdog that is
+	 * concurrently running and blocked waiting for the same lock. This
+	 * is always safe to call even if no work is pending or already ran. */
+	cancel_delayed_work_sync(&diag->restore_work);
+
+	mutex_lock(&diag->lock);
+	if (!diag->probe_active) {
+		mutex_unlock(&diag->lock);
+		dev_info(diag->dev, "restore requested but no probe is active - nothing to do\n");
+		return 0;
+	}
+	nebulaos_bl_diag_do_restore(diag, false);
+	mutex_unlock(&diag->lock);
+	return 0;
+}
+
+static int nebulaos_bl_diag_cmd_arm(struct nebulaos_bl_diag *diag)
+{
+	mutex_lock(&diag->lock);
+	diag->diag_armed = true;
+	mutex_unlock(&diag->lock);
+	dev_info(diag->dev, "diagnostic armed - probe-* commands now accepted\n");
+	return 0;
+}
+
+static int nebulaos_bl_diag_cmd_disarm(struct nebulaos_bl_diag *diag)
+{
+	/* Fail-safe: disarming always forces an immediate, synchronous
+	 * restore of any still-active probe first - "disarm" is meant to
+	 * fully de-activate this diagnostic, not merely block new probes
+	 * while leaving a currently-active one running until its watchdog
+	 * eventually fires. Same cancel-before-lock ordering as
+	 * nebulaos_bl_diag_cmd_restore()/_remove() and for the same reason
+	 * (the watchdog callback also takes diag->lock). */
+	cancel_delayed_work_sync(&diag->restore_work);
+
+	mutex_lock(&diag->lock);
+	if (diag->probe_active)
+		nebulaos_bl_diag_do_restore(diag, false);
+	diag->diag_armed = false;
+	mutex_unlock(&diag->lock);
+	dev_info(diag->dev, "diagnostic disarmed - probe-* commands now rejected\n");
+	return 0;
+}
+
+static int nebulaos_bl_diag_cmd_probe(struct nebulaos_bl_diag *diag,
+				       enum nebulaos_bl_diag_probe_type type,
+				       int value)
+{
+	unsigned int timeout_ms = NEBULAOS_BL_DIAG_DEFAULT_TIMEOUT_MS;
+	int duty_pct = -1, gpio_val = -1;
+	struct pwm_state new_state;
+	int ret = 0;
+
+	/* Every one of the 5 whitelisted "probe-*" debugfs commands maps to
+	 * exactly one fixed, compile-time-known (type, value) pair chosen by
+	 * nebulaos_bl_diag_command_write() below purely from which literal
+	 * command string was written - "value" here is always one of the
+	 * fixed literals {0, 1} (candidate enable-gpio level) or {25, 50, 75}
+	 * (candidate PWM duty percent). It is never parsed from a
+	 * user-supplied number - see the file header "COMMAND WHITELIST"
+	 * section. */
+
+	/* Defensive, compile-time-checked invariant (see the "fixed 2s probe
+	 * duration" decision in docs/NEBULAOS_BACKLIGHT_DIAGNOSTIC_PLAN.md):
+	 * every probe issued through this debugfs interface always uses
+	 * exactly NEBULAOS_BL_DIAG_DEFAULT_TIMEOUT_MS now - there is no
+	 * longer any caller-supplied timeout argument to runtime-bounds-check
+	 * (the mission's "no arbitrary timeout" requirement is satisfied one
+	 * level up, in nebulaos_bl_diag_command_write(), which rejects any of
+	 * the 9 recognized commands outright if it has ANY trailing token at
+	 * all - so no timeout value, valid or otherwise, can ever reach this
+	 * function from user input in the first place). This static_assert
+	 * keeps that guarantee honest against any future edit to the two
+	 * #define's it checks, by failing the BUILD rather than silently
+	 * letting DEFAULT drift outside [MIN,MAX]. */
+	static_assert(NEBULAOS_BL_DIAG_DEFAULT_TIMEOUT_MS >= NEBULAOS_BL_DIAG_MIN_TIMEOUT_MS &&
+		      NEBULAOS_BL_DIAG_DEFAULT_TIMEOUT_MS <= NEBULAOS_BL_DIAG_MAX_TIMEOUT_MS,
+		      "NEBULAOS_BL_DIAG_DEFAULT_TIMEOUT_MS must stay within [MIN,MAX]");
+
+	if (type == NEBULAOS_BL_DIAG_PROBE_ENABLE_GPIO) {
+		gpio_val = value;
+	} else if (type == NEBULAOS_BL_DIAG_PROBE_PWM_DUTY) {
+		/* Deliberately unreachable for 0/100/anything else - see the
+		 * file header comment: only the fixed 25/50/75 literals are
+		 * ever dispatched here at all, so this can never observe any
+		 * other value, but the check is kept as defense in depth. */
+		if (value != 25 && value != 50 && value != 75)
+			return -EINVAL;
+		duty_pct = value;
+	} else {
+		return -EINVAL;
+	}
+
+	mutex_lock(&diag->lock);
+
+	if (!diag->diag_armed) {
+		diag->probe_failure_count++;
+		mutex_unlock(&diag->lock);
+		dev_warn(diag->dev, "rejected probe: diagnostic is disarmed - write \"arm\" first\n");
+		return -EPERM;
+	}
+
+	if (diag->probe_active) {
+		diag->probe_failure_count++;
+		mutex_unlock(&diag->lock);
+		dev_warn(diag->dev, "rejected probe: another probe is already active\n");
+		return -EBUSY;
+	}
+
+	if (gpio_val >= 0 && !diag->enable_gpio) {
+		diag->probe_failure_count++;
+		mutex_unlock(&diag->lock);
+		dev_warn(diag->dev, "rejected probe: no candidate enable-gpios present\n");
+		return -ENODEV;
+	}
+
+	/* NebulaOS PWM state readback mission cross-module gate (closes the
+	 * two TODOs formerly here - see
+	 * docs/NEBULAOS_PWM_STATE_READBACK_REPORT.md and
+	 * docs/NEBULAOS_BACKLIGHT_DIAGNOSTIC_PLAN.md's addendum). Refuse to
+	 * arm/apply ANY probe - PWM or GPIO - unless its own resource's
+	 * restoration path is currently exact, per a genuine, live call into
+	 * nebulaos_bl_diag_probe_type_restore_is_exact() - never a hardcoded
+	 * answer. This must run before any hardware is touched or any state
+	 * is armed, same as every other rejection check in this function. */
+	if (!nebulaos_bl_diag_probe_type_restore_is_exact(diag, type)) {
+		diag->probe_failure_count++;
+		mutex_unlock(&diag->lock);
+		dev_warn(diag->dev,
+			 "rejected probe: restoration is not currently exact for this resource\n");
+		return -EOPNOTSUPP;
+	}
+
+	/* Step 1: capture prior state (read-only, no hardware write yet).
+	 * See the file header "RESTORATION EXACTNESS" section for what this
+	 * genuinely captures on each path. */
+	if (gpio_val >= 0)
+		diag->saved_gpio_value = gpiod_get_raw_value_cansleep(diag->enable_gpio);
+	else
+		pwm_get_state(diag->pwm, &diag->saved_pwm_state);
+
+	/* Step 2: ARM the watchdog and mark the probe active BEFORE
+	 * changing any hardware below (see the file header "ARM-BEFORE-
+	 * APPLY ORDERING" section - load-bearing, do not reorder). At this
+	 * point a crash/kill/oops racing against the apply step below is
+	 * already covered: the watchdog will fire against the just-captured
+	 * saved state, which is a harmless no-op since nothing has actually
+	 * been written to hardware yet. */
+	diag->probe_type = (gpio_val >= 0) ? NEBULAOS_BL_DIAG_PROBE_ENABLE_GPIO
+					    : NEBULAOS_BL_DIAG_PROBE_PWM_DUTY;
+	diag->requested_duty_pct = (gpio_val >= 0) ? -1 : duty_pct;
+	diag->requested_period_ns = (gpio_val >= 0) ? 0 : NEBULAOS_BL_DIAG_CANDIDATE_PERIOD_NS;
+	diag->probe_active = true;
+	diag->active_timeout_ms = timeout_ms;
+	diag->probe_deadline = jiffies + msecs_to_jiffies(timeout_ms);
+	schedule_delayed_work(&diag->restore_work, msecs_to_jiffies(timeout_ms));
+
+	/* Step 3: apply exactly one candidate state to hardware now that
+	 * restoration is already armed. */
+	if (gpio_val >= 0) {
+		gpiod_set_raw_value_cansleep(diag->enable_gpio, gpio_val);
+		diag->candidate_gpio_state = gpio_val;
+	} else {
+		new_state = diag->saved_pwm_state;
+		new_state.enabled = true;
+		new_state.period = NEBULAOS_BL_DIAG_CANDIDATE_PERIOD_NS;
+		new_state.duty_cycle = (u64)NEBULAOS_BL_DIAG_CANDIDATE_PERIOD_NS * duty_pct / 100;
+
+		ret = pwm_apply_state(diag->pwm, &new_state);
+		if (ret) {
+			/* The apply never actually took effect - unwind the
+			 * state/timer we already armed in step 2 so the
+			 * watchdog doesn't later "restore" a probe that never
+			 * ran, AND so the delayed_work object is idle again
+			 * before we release the lock below (otherwise a second
+			 * thread could call schedule_delayed_work() on this
+			 * same still-pending work item for its own new probe
+			 * immediately after we unlock, and a subsequent
+			 * cancel_delayed_work_sync() call made AFTER unlocking
+			 * would then race against - and could silently cancel -
+			 * THEIR timer instead of the one this failed attempt
+			 * armed; an earlier revision of this fix used exactly
+			 * that unlock-then-cancel_delayed_work_sync() ordering
+			 * and had this TOCTOU race).
+			 *
+			 * cancel_delayed_work() - the NON-blocking variant, not
+			 * cancel_delayed_work_sync() - is used here deliberately,
+			 * while diag->lock is still held: unlike the explicit
+			 * "restore"/remove() paths, this branch never itself
+			 * calls nebulaos_bl_diag_do_restore() (nothing was ever
+			 * actually applied for this failed attempt, so there is
+			 * nothing to restore), so correctness does not depend on
+			 * blocking until any in-flight watchdog callback has
+			 * fully finished - it only needs the pending timer entry
+			 * removed so a future schedule_delayed_work() call is
+			 * honored rather than silently ignored as already-
+			 * pending. cancel_delayed_work() never blocks, so calling
+			 * it here cannot deadlock against the watchdog callback
+			 * trying to take this same lock (unlike
+			 * cancel_delayed_work_sync(), which is exactly why every
+			 * OTHER call site in this file always calls that blocking
+			 * variant only without the lock held). In the
+			 * vanishingly unlikely case the watchdog had already
+			 * started running before this cancel call (impractical
+			 * here: pwm_apply_state() fails synchronously, almost
+			 * always long before NEBULAOS_BL_DIAG_MIN_TIMEOUT_MS's
+			 * 250ms floor could elapse), it will simply observe
+			 * probe_active == false below and no-op, exactly like
+			 * every other nebulaos_bl_diag_do_restore() caller
+			 * already tolerates. */
+			cancel_delayed_work(&diag->restore_work);
+			diag->probe_active = false;
+			diag->probe_type = NEBULAOS_BL_DIAG_PROBE_NONE;
+			diag->requested_duty_pct = -1;
+			diag->requested_period_ns = 0;
+			diag->probe_failure_count++;
+			mutex_unlock(&diag->lock);
+			dev_err(diag->dev, "probe pwm %d%% failed to apply: %d\n", duty_pct, ret);
+			return ret;
+		}
+	}
+
+	mutex_unlock(&diag->lock);
+
+	dev_info(diag->dev, "probe active: type=%d value=%d, auto-restoring in %ums\n",
+		 type, value, timeout_ms);
+	return 0;
+}
+
+static int nebulaos_bl_diag_cmd_status_log(struct nebulaos_bl_diag *diag)
+{
+	unsigned long remaining_ms = 0;
+	bool pwm_exact, gpio_exact;
+
+	mutex_lock(&diag->lock);
+	if (diag->probe_active) {
+		long delta = (long)(diag->probe_deadline - jiffies);
+
+		remaining_ms = delta > 0 ? jiffies_to_msecs(delta) : 0;
+	}
+	pwm_exact = nebulaos_bl_diag_pwm_restore_is_exact(diag);
+	gpio_exact = nebulaos_bl_diag_gpio_restore_is_exact(diag);
+	dev_info(diag->dev,
+		 "status: armed=%d active=%d type=%d duty=%d%% period=%luns gpio=%d "
+		 "timeout_remaining=%lums restore_count=%u probe_failure_count=%u "
+		 "watchdog_restoration_count=%u pwm_restore_is_exact=%d gpio_restore_is_exact=%d\n",
+		 diag->diag_armed, diag->probe_active, diag->probe_type, diag->requested_duty_pct,
+		 diag->requested_period_ns, diag->candidate_gpio_state, remaining_ms,
+		 diag->restore_count, diag->probe_failure_count,
+		 diag->watchdog_restoration_count, pwm_exact ? 1 : 0,
+		 diag->enable_gpio ? (gpio_exact ? 1 : 0) : -1);
+	mutex_unlock(&diag->lock);
+	return 0;
+}
+
+static ssize_t nebulaos_bl_diag_command_write(struct file *file, const char __user *ubuf,
+					       size_t count, loff_t *ppos)
+{
+	struct nebulaos_bl_diag *diag = file->private_data;
+	char buf[64];
+	size_t len;
+	char *p, *cmd, *rest;
+	int ret;
+
+	if (count == 0 || count >= sizeof(buf))
+		return -EINVAL;
+	len = count;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	p = strim(buf);
+	cmd = strsep(&p, " ");
+	if (!cmd || !*cmd)
+		return -EINVAL;
+
+	/* Whitelist enforcement (command-interface hardening pass - see the
+	 * file header "COMMAND WHITELIST" section): exactly the 9 literal
+	 * command strings below are ever recognized, each taking ZERO
+	 * arguments. Any trailing token after the command word - an
+	 * arbitrary GPIO/channel number, a duty cycle, a period, a timeout,
+	 * an MMIO address, anything at all - is rejected outright with
+	 * -EINVAL here, not silently ignored and not silently truncated.
+	 * This single check is what makes it structurally impossible to
+	 * smuggle an arbitrary GPIO/channel/duty/period/timeout through this
+	 * interface: there is no longer any parser path in this file that
+	 * ever calls kstrtouint()/strcmp() against a second or third
+	 * user-supplied token. */
+	rest = p ? strim(p) : NULL;
+	if (rest && *rest)
+		return -EINVAL;
+
+	if (!strcmp(cmd, "status"))
+		ret = nebulaos_bl_diag_cmd_status_log(diag);
+	else if (!strcmp(cmd, "arm"))
+		ret = nebulaos_bl_diag_cmd_arm(diag);
+	else if (!strcmp(cmd, "disarm"))
+		ret = nebulaos_bl_diag_cmd_disarm(diag);
+	else if (!strcmp(cmd, "restore"))
+		ret = nebulaos_bl_diag_cmd_restore(diag);
+	else if (!strcmp(cmd, "probe-enable-low"))
+		ret = nebulaos_bl_diag_cmd_probe(diag, NEBULAOS_BL_DIAG_PROBE_ENABLE_GPIO, 0);
+	else if (!strcmp(cmd, "probe-enable-high"))
+		ret = nebulaos_bl_diag_cmd_probe(diag, NEBULAOS_BL_DIAG_PROBE_ENABLE_GPIO, 1);
+	else if (!strcmp(cmd, "probe-pwm-25"))
+		ret = nebulaos_bl_diag_cmd_probe(diag, NEBULAOS_BL_DIAG_PROBE_PWM_DUTY, 25);
+	else if (!strcmp(cmd, "probe-pwm-50"))
+		ret = nebulaos_bl_diag_cmd_probe(diag, NEBULAOS_BL_DIAG_PROBE_PWM_DUTY, 50);
+	else if (!strcmp(cmd, "probe-pwm-75"))
+		ret = nebulaos_bl_diag_cmd_probe(diag, NEBULAOS_BL_DIAG_PROBE_PWM_DUTY, 75);
+	else
+		/* Anything not in the 9-command whitelist above is rejected
+		 * outright, not silently ignored - covers arbitrary/legacy
+		 * forms like the earlier prototype's "probe enable low",
+		 * "probe pwm 0", "probe pwm 100", or any made-up command. */
+		ret = -EINVAL;
+
+	return ret < 0 ? ret : count;
+}
+
+static const struct file_operations nebulaos_bl_diag_command_fops = {
+	.open = simple_open,
+	.write = nebulaos_bl_diag_command_write,
+	.llseek = no_llseek,
+};
+
+static int nebulaos_bl_diag_status_show(struct seq_file *s, void *unused)
+{
+	struct nebulaos_bl_diag *diag = s->private;
+	unsigned long remaining_ms = 0;
+	bool pwm_exact, gpio_exact;
+
+	mutex_lock(&diag->lock);
+	if (diag->probe_active) {
+		long delta = (long)(diag->probe_deadline - jiffies);
+
+		remaining_ms = delta > 0 ? jiffies_to_msecs(delta) : 0;
+	}
+	seq_puts(s, "candidate_channel: 0\n");
+	seq_printf(s, "diag_armed: %d\n", diag->diag_armed);
+	seq_printf(s, "requested_duty_pct: %d\n", diag->requested_duty_pct);
+	seq_printf(s, "requested_period_ns: %lu\n", diag->requested_period_ns);
+	seq_printf(s, "candidate_gpio_state: %d\n", diag->candidate_gpio_state);
+	seq_printf(s, "probe_active: %d\n", diag->probe_active);
+	seq_printf(s, "timeout_remaining_ms: %lu\n", remaining_ms);
+	seq_printf(s, "restore_count: %u\n", diag->restore_count);
+	seq_printf(s, "probe_failure_count: %u\n", diag->probe_failure_count);
+	seq_printf(s, "watchdog_restoration_count: %u\n", diag->watchdog_restoration_count);
+	/*
+	 * Honest restoration-exactness fields - see the file header
+	 * "RESTORATION EXACTNESS" / "PWM-EXACTNESS GATE" sections.
+	 *
+	 * RESOLVED (NebulaOS PWM state readback cross-module wiring pass,
+	 * 2026-08-xx): pwm_restore_is_exact is no longer a hardcoded 0 - it
+	 * is the real, live result of
+	 * nebulaos_bl_diag_pwm_restore_is_exact(), which calls the exported
+	 * ingenic_pwm_channel_get_state_is_exact() for this exact candidate
+	 * channel whenever CONFIG_PWM_INGENIC_V2_GET_STATE is selected and
+	 * the bound chip is confirmed to actually be pwm-ingenic-v2's own,
+	 * and conservatively reports 0 (not exact) otherwise - never 1
+	 * unless the underlying driver genuinely confirmed it. This closes
+	 * the TODO that used to live at this exact call site (see git log
+	 * for the prior revision's placeholder comment). gpio_restore_is_exact
+	 * is 1 when the candidate enable-gpios is present, because
+	 * ingenic_gpio_get() reads the live PxPIN register on every call -
+	 * that restoration target is a genuine hardware readback, unrelated
+	 * to the PWM readback capability. -1 means no candidate GPIO exists
+	 * on this DT node at all, so the field is not applicable.
+	 */
+	pwm_exact = nebulaos_bl_diag_pwm_restore_is_exact(diag);
+	gpio_exact = nebulaos_bl_diag_gpio_restore_is_exact(diag);
+	seq_printf(s, "pwm_restore_is_exact: %d\n", pwm_exact ? 1 : 0);
+	seq_printf(s, "gpio_restore_is_exact: %d\n", diag->enable_gpio ? (gpio_exact ? 1 : 0) : -1);
+	mutex_unlock(&diag->lock);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(nebulaos_bl_diag_status);
+
+static int nebulaos_bl_diag_probe(struct platform_device *pdev)
+{
+	struct nebulaos_bl_diag *diag;
+	struct device *dev = &pdev->dev;
+
+	diag = devm_kzalloc(dev, sizeof(*diag), GFP_KERNEL);
+	if (!diag)
+		return -ENOMEM;
+
+	diag->dev = dev;
+	diag->candidate_gpio_state = -1;
+	diag->saved_gpio_value = -1;
+	diag->requested_duty_pct = -1;
+	/* Disarmed at every boot/bind - no probe-* command is accepted until
+	 * an explicit "arm" is written. Zero hardware-state change occurs
+	 * here either way - see the "Read-only from this driver's point of
+	 * view" comment below. */
+	diag->diag_armed = false;
+	mutex_init(&diag->lock);
+	INIT_DELAYED_WORK(&diag->restore_work, nebulaos_bl_diag_restore_work);
+
+	diag->pwm = devm_pwm_get(dev, NULL);
+	if (IS_ERR(diag->pwm)) {
+		dev_err(dev, "failed to get candidate PWM: %ld\n", PTR_ERR(diag->pwm));
+		return PTR_ERR(diag->pwm);
+	}
+	/* Read-only from this driver's point of view: pwm_get_state() never
+	 * calls into hardware here, it just reads the PWM core's cached
+	 * pwm_device.state. This driver must NEVER call pwm_apply_state()
+	 * at bind time. IMPORTANT, see the file header "RESTORATION
+	 * EXACTNESS" section: whether that cached state was itself populated
+	 * from a real register read depends on whether pwm-ingenic-v2.c's
+	 * .get_state is compiled in and reports this channel exact - see
+	 * nebulaos_bl_diag_pwm_restore_is_exact(). Binding this driver still
+	 * never WRITES anything to hardware either way, so it remains true
+	 * that probing is 100% opt-in regardless of that answer. */
+	pwm_get_state(diag->pwm, &diag->saved_pwm_state);
+
+	/* GPIOD_ASIS: acquire the descriptor's current direction/value
+	 * without driving it - acquiring this consumer must never itself
+	 * change the pin's state. Optional: if the candidate enable-gpios
+	 * property is absent, this is simply NULL, and every
+	 * "probe-enable-*" command is rejected as unavailable (-ENODEV)
+	 * while the PWM probes still work normally (subject to their own
+	 * exactness gate). Unlike the PWM side above, this IS always a
+	 * genuine hardware readback - see the file header "RESTORATION
+	 * EXACTNESS" section. */
+	diag->enable_gpio = devm_gpiod_get_optional(dev, "enable", GPIOD_ASIS);
+	if (IS_ERR(diag->enable_gpio)) {
+		dev_err(dev, "failed to get candidate enable-gpios: %ld\n",
+			PTR_ERR(diag->enable_gpio));
+		return PTR_ERR(diag->enable_gpio);
+	}
+	if (diag->enable_gpio) {
+		diag->saved_gpio_value = gpiod_get_raw_value_cansleep(diag->enable_gpio);
+		diag->candidate_gpio_state = diag->saved_gpio_value;
+	}
+
+	platform_set_drvdata(pdev, diag);
+
+	diag->debugfs_dir = debugfs_create_dir(NEBULAOS_BL_DIAG_NAME, NULL);
+	if (IS_ERR_OR_NULL(diag->debugfs_dir)) {
+		dev_warn(dev, "debugfs unavailable - diagnostic interface not exposed\n");
+		diag->debugfs_dir = NULL;
+	} else {
+		debugfs_create_file("command", 0200, diag->debugfs_dir, diag,
+				     &nebulaos_bl_diag_command_fops);
+		debugfs_create_file("status", 0444, diag->debugfs_dir, diag,
+				     &nebulaos_bl_diag_status_fops);
+	}
+
+	dev_info(dev, "backlight probe diagnostic ready (bounded, opt-in via debugfs, "
+		 "disarmed by default; boot-time PWM/GPIO state untouched; see "
+		 ".../status pwm_restore_is_exact/gpio_restore_is_exact for whether "
+		 "restoration is currently exact)\n");
+	return 0;
+}
+
+static int nebulaos_bl_diag_remove(struct platform_device *pdev)
+{
+	struct nebulaos_bl_diag *diag = platform_get_drvdata(pdev);
+
+	/* Remove debugfs first so no new probe command can race with the
+	 * teardown below. */
+	debugfs_remove_recursive(diag->debugfs_dir);
+	diag->debugfs_dir = NULL;
+
+	/* See nebulaos_bl_diag_cmd_restore() for why this must run before
+	 * taking diag->lock. */
+	cancel_delayed_work_sync(&diag->restore_work);
+
+	mutex_lock(&diag->lock);
+	if (diag->probe_active)
+		nebulaos_bl_diag_do_restore(diag, false);
+	mutex_unlock(&diag->lock);
+
+	return 0;
+}
+
+static const struct of_device_id nebulaos_bl_diag_of_match[] = {
+	{ .compatible = "nebulaos,backlight-probe-diag" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, nebulaos_bl_diag_of_match);
+
+static struct platform_driver nebulaos_bl_diag_driver = {
+	.probe = nebulaos_bl_diag_probe,
+	.remove = nebulaos_bl_diag_remove,
+	.driver = {
+		.name = NEBULAOS_BL_DIAG_NAME,
+		.of_match_table = nebulaos_bl_diag_of_match,
+	},
+};
+module_platform_driver(nebulaos_bl_diag_driver);
+
+MODULE_DESCRIPTION("NebulaOS bounded backlight PWM/GPIO probe diagnostic (DISPLAY-B0-DIAG)");
+MODULE_LICENSE("GPL");
