+#ifdef CONFIG_TOUCHSCREEN_NS2009_IRQ_DIAG
+/* TOUCH-I0-DIAG: threaded IRQ handler (process context, requested with a
+ * NULL hard-IRQ handler below, so this is the only handler that ever
+ * runs). Deliberately does NOT call ns2009_ts_report(), NOT any
+ * i2c_smbus_* function, and NOT any input_report_*() function - zero I2C
+ * transfers, zero coordinate processing occur anywhere in this function
+ * (verifiable directly by inspection: this function's body contains no
+ * such calls). It only samples the pin's current level for best-effort
+ * edge classification and updates in-memory counters. */
+static irqreturn_t ns2009_irq_diag_thread(int irq, void *dev_id)
+{
+	struct ns2009_data *data = dev_id;
+	unsigned long now = jiffies;
+	unsigned long interval;
+	int level;
+
+	if (data->diag_storm_fallback_active)
+		return IRQ_HANDLED;
+
+	atomic_inc(&data->diag_irq_event_count);
+
+	if (data->diag_last_irq_jiffies) {
+		interval = now - data->diag_last_irq_jiffies;
+		if (data->diag_min_irq_interval_jiffies == 0 ||
+		    interval < data->diag_min_irq_interval_jiffies)
+			data->diag_min_irq_interval_jiffies = interval;
+		if (interval > data->diag_max_irq_interval_jiffies)
+			data->diag_max_irq_interval_jiffies = interval;
+	}
+	data->diag_last_irq_jiffies = now;
+
+	/* Best-effort edge classification only, NEVER authoritative: sample
+	 * the pin's current level right now and infer "rising" if it reads
+	 * asserted, "falling" otherwise. Inherently racy against a fast
+	 * bounce between the real edge and this read - purely a
+	 * characterization aid for a human reviewing these counters, not a
+	 * claim about true trigger polarity (which remains genuinely
+	 * unproven - see touch-path-analysis.txt). This same
+	 * gpiod_get_raw_value_cansleep() read is the only pin access this
+	 * function ever performs - no I2C bus access of any kind. */
+	level = gpiod_get_raw_value_cansleep(data->pendown_gpio);
+	if (level)
+		atomic_inc(&data->diag_irq_rising_count);
+	else
+		atomic_inc(&data->diag_irq_falling_count);
+
+	/* Purely observational cross-reference against the existing,
+	 * unmodified poll-derived pen_down state. */
+	if (data->pen_down)
+		atomic_inc(&data->diag_irq_events_while_touch_held);
+	else
+		atomic_inc(&data->diag_irq_events_while_no_touch);
+
+	/* Storm protection - same shape as touch-irq-gate.patch's
+	 * proven-safe design: a rolling 1-second/50-edge threshold that
+	 * permanently disables this diagnostic IRQ (never the poll) once
+	 * tripped, for the remaining lifetime of the device instance. */
+	if (time_before(now, data->diag_storm_window_start +
+			msecs_to_jiffies(NS2009_IRQ_DIAG_STORM_WINDOW_MS))) {
+		data->diag_storm_window_count++;
+		if (data->diag_storm_window_count > NS2009_IRQ_DIAG_STORM_THRESHOLD) {
+			data->diag_storm_fallback_active = true;
+			data->diag_irq_active = false;
+			atomic_inc(&data->diag_storm_triggered_count);
+			disable_irq_nosync(irq);
+			if (printk_ratelimit())
+				dev_warn(&data->client->dev,
+					 "IRQ-diagnostic storm detected (>%d edges in %dms) - "
+					 "disabling diagnostic IRQ permanently, poll is unaffected\n",
+					 NS2009_IRQ_DIAG_STORM_THRESHOLD,
+					 NS2009_IRQ_DIAG_STORM_WINDOW_MS);
+		}
+	} else {
+		data->diag_storm_window_start = now;
+		data->diag_storm_window_count = 1;
+	}
+
+	return IRQ_HANDLED;
+}
+#endif
