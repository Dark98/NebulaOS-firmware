# Local additions on top of x2000_halley5_v30_linux_defconfig for the OpenKE
# ke-mainline-klipper Phase 2 rebase. Kept as a real Buildroot config fragment
# (BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES) rather than hand-edited into
# output/build/linux-custom/.config, since that gets wiped on every
# `make linux-reconfigure` - this file is what actually persists.

# WiFi: mainline brcmfmac (SDIO), real chip confirmed live: Cypress CYW43438.
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_PROTO_BCDC=y

# Bluetooth: H5/three-wire (matches the original device's own module name,
# hci_uart_h5_kernel_4_4_94.ko, and confirmed via the real board DTS that this
# UART has no hardware RTS/CTS wiring - halley5_v30.dts selects the 2-pin
# uart3_pc pinmux group, not the 4-pin uart3_pd group with flow control, so H4
# was never actually viable here). Stock CONFIG_BT_HCIUART_BCM only works over
# H4 (it selects BT_HCIUART_H4) - CONFIG_BT_HCIUART_BCM_H5 is a real, new
# OpenKE addition (drivers/bluetooth/hci_h5.c) that wires the same
# btbcm_initialize()/btbcm_finalize() firmware-loading calls into H5 instead,
# following the same h5_vnd pattern the existing Realtek support already uses.
# UNTESTED against real hardware - see FIRMWARE.md.
CONFIG_BT=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIUART_BCM_H5=y

# Touch: NS2009 driver (ported from Icenowy Zheng's real GPLv2 driver, see
# artifacts/ns2009-driver/). The whole touchscreen subsystem menu is off by
# default in this defconfig.
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_NS2009=m

# Display: best-effort panel driver for the real 480x272 panel (timing values
# not confirmed against a real datasheet, see the driver's own header comment
# and FIRMWARE.md). CONFIG_FB_INGENIC_STAGE/CONFIG_FB_INGENIC are already on
# by default in this defconfig - this just adds our new panel to the mix.
CONFIG_STAGE_OPENKE_GENERAL_480X272=m
