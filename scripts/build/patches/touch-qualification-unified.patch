diff --git a/kernel/kernel-6.6/drivers/input/touchscreen/Kconfig b/kernel/kernel-6.6/drivers/input/touchscreen/Kconfig
index d6a9b95cb..441bea810 100644
--- a/kernel/kernel-6.6/drivers/input/touchscreen/Kconfig
+++ b/kernel/kernel-6.6/drivers/input/touchscreen/Kconfig
@@ -1155,6 +1155,52 @@ config TOUCHSCREEN_NS2009
 	  To compile this driver as a module, choose M here: the
 	  module will be called ns2009.
 
+config TOUCHSCREEN_NS2009_QUALIFICATION
+	bool "add a unified poll/IRQ-observe/IRQ-assist qualification mode for pendown-gpios (TOUCH-QUALIFICATION)"
+	depends on TOUCHSCREEN_NS2009
+	default n
+	help
+	  TOUCH-QUALIFICATION (display/touch investigation mission
+	  unification, 2026-08-01+): supersedes the separate TOUCH-D0-DIAG
+	  (CONFIG_TOUCHSCREEN_NS2009_POLL_DIAG) and TOUCH-I0-DIAG
+	  (CONFIG_TOUCHSCREEN_NS2009_IRQ_DIAG) diagnostics with ONE
+	  Kconfig-gated feature and ONE runtime-selectable mode, so the two
+	  can never again be silently clobbered by composing mutually
+	  exclusive kernel-tree toggle scripts against the same two files.
+
+	  Adds a runtime mode switch (debugfs ns2009_qualification/mode, one
+	  of "poll-only" / "irq-observe" / "irq-assist") defaulting to
+	  poll-only at every boot:
+
+	    poll-only   - byte-for-byte identical to the existing,
+	                  unmodified 30ms poll path. No GPIO IRQ requested.
+	    irq-observe - additionally requests the pendown-gpios IRQ
+	                  (FALLING edge only - PROVEN_FROM_LIVE_TEST GPIO79
+	                  is IDLE_HIGH_ACTIVE_LOW, see
+	                  docs/NEBULAOS_TOUCH_IRQ_TRIGGER_FINDINGS.md) purely
+	                  to observe/count events. Zero I2C, zero coordinate
+	                  processing in the handler. The 30ms poll keeps
+	                  running unconditionally and unchanged.
+	    irq-assist  - only reachable after irq-observe has been selected
+	                  at least once this boot. Arms the falling-edge IRQ
+	                  plus a conservative 250ms safety poll while idle;
+	                  on IRQ, masks the line and kicks the existing poll
+	                  cadence to 30ms for the duration of the contact
+	                  (reusing the real poll/report function, never
+	                  reimplementing coordinate acquisition); on release
+	                  (detected by the existing release logic), confirms
+	                  the GPIO reads idle-high, drops back to the 250ms
+	                  safety poll and re-arms the IRQ.
+
+	  Any of: an IRQ request failure, an IRQ storm (>50 events/rolling
+	  1s), a repeated IRQ during one already-held irq-assist contact, a
+	  failed release confirmation, an inconsistent pen state transition,
+	  or a failed internal mode-transition action permanently falls the
+	  device back to poll-only for the remainder of that boot - one
+	  ratelimited kernel warning only, never per-event log spam.
+
+	  Disabled by default. If unsure, say N.
+
 config TOUCHSCREEN_TSC2007
 	tristate "TSC2007 based touchscreens"
 	depends on I2C
