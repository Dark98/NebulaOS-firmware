#!/bin/sh
#
# OpenKE addition (FIRMWARE.md sec 13): starts Moonraker. Must come after
# S55klipper - connects to klippy's API-server Unix socket as a client via
# moonraker.conf's [server] klippy_uds_address, which already correctly
# points at klippy.sock.
#
# UNIXSOCKET below is a completely different thing: moonraker.py's own
# -u/--unixsocket flag sets its *own* "extensions" agent-socket server
# (components/extensions.py's create_unix_server), unrelated to the
# klippy connection. This previously pointed at klippy.sock itself, which
# made Moonraker bind a second listening socket directly on top of
# Klipper's own socket path - moonraker's own extensions server replaced
# Klipper's real socket file, so any *new* connection attempt to that path
# (including moonraker's own klippy_connection reconnect logic) landed on
# moonraker's extensions listener instead of real Klipper, producing a
# continuous flood of "JSON-RPC Request Error -32600, Invalid Request" and
# "Unknown method received: notify_proc_stat_update" and leaving Moonraker
# permanently stuck before the Klippy-ready handshake (GuppyScreen/Mainsail
# stuck on "waiting for printer to initialize" forever, even though Klipper
# itself was fully connected to the real MCU). Fixed by giving Moonraker's
# own extensions socket its own separate path.
MOONRAKER=/opt/moonraker/moonraker/moonraker.py
CONFIG=/opt/printer_data/config/moonraker.conf
DATAPATH=/opt/printer_data
LOGFILE=/opt/printer_data/logs/moonraker.log
UNIXSOCKET=/opt/printer_data/comms/moonraker.sock
PIDFILE=/var/run/moonraker.pid

# NebulaOS mutable-runtime mission, Phase 7: prefer the writable venv
# S04nebulaos-factory-seed creates at /usr/data/nebulaos/envs/moonraker
# (matches this same path in moonraker.conf's own
# [update_manager moonraker] virtualenv: setting) - falls back to the
# system interpreter if the venv doesn't exist yet (e.g. a freshly wiped
# namespace on its very first boot, before S04 has run) so this script
# never fails to start Moonraker over a missing venv.
PYTHON3=/usr/bin/python3
[ -x /usr/data/nebulaos/envs/moonraker/bin/python3 ] && PYTHON3=/usr/data/nebulaos/envs/moonraker/bin/python3

start() {
	echo "Starting moonraker (using $PYTHON3)"
	start-stop-daemon -S -b -m -p "$PIDFILE" \
		-x "$PYTHON3" -- \
		"$MOONRAKER" -d "$DATAPATH" -c "$CONFIG" -l "$LOGFILE" \
		-u "$UNIXSOCKET"
	# NebulaOS Memory Resilience Gate: moderately protected - Moonraker
	# coordinates updates/rollback and must survive memory pressure
	# preferentially over GuppyScreen/webcam/update-helper processes, but
	# less critically than Klipper itself (docs/NEBULAOS_MEMORY_RESILIENCE.md
	# sec 7).
	[ -f "$PIDFILE" ] && echo -400 > "/proc/$(cat "$PIDFILE")/oom_score_adj" 2>/dev/null
}

stop() {
	echo "Stopping moonraker"
	start-stop-daemon -K -p "$PIDFILE"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
