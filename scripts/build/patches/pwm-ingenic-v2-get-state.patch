+static ssize_t pwm_show_get_state_exact(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct ingenic_pwm_chip *ingenic_pwm = dev_get_drvdata(dev);
+	int channel = ingenic_pwm->debug_current_id;
