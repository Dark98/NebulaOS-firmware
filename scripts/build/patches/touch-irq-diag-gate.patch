+	bool				diag_irq_active;
+	bool				diag_storm_fallback_active;
+	int				diag_irq_request_failure;	/* 0 = none/not attempted */
+	unsigned long			diag_storm_window_start;
+	unsigned int			diag_storm_window_count;
+	atomic_t			diag_irq_event_count;
