#!/bin/sh
#
# Flips the ota marker forward again (FIRMWARE.md sec 21/22), confirming this
# boot as good enough to keep booting on subsequent reboots too - but only
# after actually checking the real app stack is up, not just because init
# reached this point. Runs last (S99), well after klipper/moonraker/
# guppyscreen/nginx have been started by their own S5x scripts - "started"
# isn't "healthy" though, so this polls Moonraker's own HTTP API for real
# confirmation rather than assuming.
#
# If the retry loop below times out without Moonraker ever responding, this
# script deliberately does NOT flip the marker forward - S00revert-safety's
# "ota:kernel" (stock) stays in place, so the next reboot goes back to stock
# rather than retrying a boot that never actually got healthy.
#
# wget here is BusyBox's applet (no full wget/curl in this rootfs) - confirmed
# CONFIG_FEATURE_WGET_LONG_OPTIONS + CONFIG_FEATURE_WGET_TIMEOUT are both
# enabled in this build, and this is plain local HTTP (no TLS involved), so
# the HTTPS-support gap that bit an earlier fetch in this project doesn't
# apply here.
#
# Byte format for the marker write: /etc/ota_marker.sh (shared with
# S00revert-safety) - verified byte-for-byte before being trusted here.

. /etc/ota_marker.sh

RETRIES=30
DELAY=5

check_moonraker() {
	wget -q -O - --timeout=3 "http://127.0.0.1:7125/server/info" 2>/dev/null | grep -q '"result"'
}

case "$1" in
	start)
		i=0
		while [ "$i" -lt "$RETRIES" ]; do
			if check_moonraker; then
				write_ota_marker "ota:kernel2"
				echo "S99confirm-good: Moonraker confirmed healthy, ota marker flipped forward"
				exit 0
			fi
			i=$((i + 1))
			sleep "$DELAY"
		done
		echo "S99confirm-good: Moonraker never confirmed healthy after $((RETRIES * DELAY))s - leaving ota marker on stock" 1>&2
		exit 1
		;;
	*)
		;;
esac
exit 0
