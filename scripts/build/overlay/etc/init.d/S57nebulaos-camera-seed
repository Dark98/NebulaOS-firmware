#!/bin/sh
#
# NebulaOS Moonraker update/camera implementation mission (2026-07-27, see
# docs/NEBULAOS_MOONRAKER_UPDATE_AND_CAMERA_ANALYSIS.md). Runs
# /usr/libexec/nebulaos-seed-camera in the background, same
# never-block-boot convention as S45nebulaos-cleanup - the script itself
# already retries with a bounded backoff while waiting for Moonraker to
# answer its own webcam API, so backgrounding here is what keeps that wait
# from ever delaying the rest of boot.
#
# Runs after S56moonraker (Moonraker's own startup) by number, though the
# script does not actually depend on strict ordering - it polls Moonraker's
# real HTTP API rather than assuming any particular timing.

if [ "$1" = "start" ]; then
	/usr/bin/python3 /usr/libexec/nebulaos-seed-camera >> /usr/data/nebulaos/maintenance/logs/camera-seed.log 2>&1 &
fi
exit 0
