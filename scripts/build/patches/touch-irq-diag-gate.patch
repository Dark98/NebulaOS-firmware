+#ifdef CONFIG_TOUCHSCREEN_NS2009_IRQ_DIAG
+/* TOUCH-I0-DIAG (display/touch investigation mission follow-on,
+ * 2026-08-01+): DIAGNOSTIC ONLY - observes whether GPIO79/pendown-gpios
+ * can generate usable IRQ events at all, independent of and in addition
+ * to the existing, permanently-unconditional 30ms poll below (never
+ * modified, disabled, or made conditional by this option). The IRQ
+ * handler does zero I2C transfers and zero coordinate processing - it is
+ * purely a counter/observation path, never a second source of touch
+ * reports (unlike CONFIG_TOUCHSCREEN_NS2009_PENDOWN_IRQ, a separate,
+ * independently-gated production-latency prototype that DOES call
+ * ns2009_ts_report() from its handler - this diagnostic deliberately does
+ * not, so it can characterize IRQ behavior in complete isolation from the
+ * touch-reporting path).
+ *
+ * Requests a FALLING-edge trigger (touch-down only) - finalized 2026-08-01
+ * from real TOUCH-D0-DIAG live evidence classifying GPIO79 as
+ * IDLE_HIGH_ACTIVE_LOW (see docs/NEBULAOS_TOUCH_IRQ_TRIGGER_FINDINGS.md),
+ * superseding this file's earlier both-edges design (which existed only
+ * because the true active-high/low and edge-direction semantics were not
+ * yet established from source/disassembly alone - see
+ * touch-path-analysis.txt for that now-resolved history). Release is still
+ * detected by the poll path alone, unchanged - this diagnostic never
+ * reports release, only touch-down IRQ timing. */
+#define NS2009_IRQ_DIAG_STORM_WINDOW_MS		1000
+#define NS2009_IRQ_DIAG_STORM_THRESHOLD	50
+#endif
